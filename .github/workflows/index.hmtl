];

// Persistent Store upgraded with streaking state and onboarding
let GymStore = {
    schedule: [],
    history: [],
    calendarNotes: {},
    theme: 'slate-light',
    onboarded: false,
    streak: 0,
    longestStreak: 0,
    skipCards: 1,
    lastSkipResetMonth: null
};

let currentRestDay = 6;
let calendarDate = new Date();
let currentYear = calendarDate.getFullYear();
let currentMonth = calendarDate.getMonth();

// --- STORAGE HANDLERS ---
function loadStore() {
    const data = localStorage.getItem('gym_store_v2');
    if (data) {
        try {
            const parsed = JSON.parse(data);
            GymStore.schedule = parsed.schedule || [];
            GymStore.history = parsed.history || [];
            GymStore.calendarNotes = parsed.calendarNotes || {};
            GymStore.theme = parsed.theme || 'slate-light';
            GymStore.onboarded = parsed.onboarded === true;
            GymStore.streak = parsed.streak || 0;
            GymStore.longestStreak = parsed.longestStreak || 0;
            GymStore.skipCards = parsed.skipCards !== undefined ? parsed.skipCards : 1;
            GymStore.lastSkipResetMonth = parsed.lastSkipResetMonth || null;
            
            const rDay = GymStore.schedule.findIndex(d => d.rest);
            if (rDay !== -1) {
                currentRestDay = rDay;
            }
        } catch(e) {
            console.error("Error parsing store:", e);
            initDefaultStore();
        }
    } else {
        // Fallback check for v1 local storage data
        const oldData = localStorage.getItem('gym_store_v1');
        if (oldData) {
            try {
                const parsed = JSON.parse(oldData);
                GymStore.schedule = parsed.schedule || [];
                GymStore.history = parsed.history || [];
                GymStore.calendarNotes = parsed.calendarNotes || {};
                GymStore.theme = 'slate-light';
                GymStore.onboarded = true;
                GymStore.streak = 1;
                GymStore.longestStreak = 1;
                GymStore.skipCards = 1;
                saveStore();
            } catch(e) {
                initDefaultStore();
            }
        } else {
            initDefaultStore();
        }
    }
    
    // Check if we need to reset skip cards (1 per calendar month)
    const currentMonthNum = new Date().getMonth();
    if (GymStore.lastSkipResetMonth !== currentMonthNum) {
        GymStore.skipCards = 1;
        GymStore.lastSkipResetMonth = currentMonthNum;
        saveStore();
    }
}

function initDefaultStore() {
    GymStore.schedule = [];
    let activeIdx = 0;
    DAYS.forEach((day, i) => {
        if (i === 6) { // Sunday default rest
            GymStore.schedule.push({
                type: 'rest',
                name: 'Rest Day',
                dbIndex: -1,
                m1: 'REST',
                sub1: 'RECOVERY DAY',
                m2: '',
                sub2: '',
                rest: true,
                customExercises: null
            });
        } else {
            const w = WORKOUTS[activeIdx] || WORKOUTS[0];
            let displayName = '';
            if (w.type === 'push') displayName = w.m1 === 'CHEST' && w.sub1.includes('Upper') ? 'Push 1' : 'Push 2';
            else if (w.type === 'pull') displayName = w.m1 === 'BACK' && w.sub1.includes('Width') ? 'Pull 1' : 'Pull 2';
            else displayName = w.m1 === 'LEGS' && w.sub1.includes('Posterior') ? 'Legs 1 & Shoulders 1' : 'Legs 2 & Shoulders 2';
            
            GymStore.schedule.push({
                type: w.type,
                name: displayName,
                dbIndex: activeIdx,
                m1: w.m1,
                sub1: w.sub1,
                m2: w.m2,
                sub2: w.sub2,
                rest: false,
                customExercises: null
            });
            activeIdx++;
        }
    });
    GymStore.history = [];
    GymStore.calendarNotes = {};
    GymStore.theme = 'slate-light';
    GymStore.onboarded = false;
    GymStore.streak = 0;
    GymStore.longestStreak = 0;
    GymStore.skipCards = 1;
    GymStore.lastSkipResetMonth = new Date().getMonth();
    saveStore();
}

function saveStore() {
    localStorage.setItem('gym_store_v2', JSON.stringify(GymStore));
    
    // Update headers and widgets
    const hudLogged = document.getElementById('hudLoggedCount');
    if (hudLogged) hudLogged.innerText = GymStore.history.length;
    
    const hudStreak = document.getElementById('hudStreak');
    if (hudStreak) hudStreak.innerText = `🔥 ${GymStore.streak} Days`;
    
    const hudSkipCards = document.getElementById('hudSkipCards');
    if (hudSkipCards) hudSkipCards.innerText = `⚡ ${GymStore.skipCards}/1`;
    
    updateHeaderProgressBar();
}

function init() {
    loadStore();
    applyTheme();
    ConfettiEngine.init();
    
    // Check if shared plan in query
    checkSharedQuery();
    
    renderPicker();
    renderGrid();
    switchTab('week');
    calculateStreakValue();
}

// CONFETTI CANVAS ENGINE
const ConfettiEngine = {
    canvas: null,
    ctx: null,
    particles: [],
    animationFrame: null,
    init() {
        this.canvas = document.getElementById('confettiCanvas');
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        window.addEventListener('resize', () => this.resize());
        this.resize();
    },
    resize() {
        if (this.canvas) {
            this.canvas.width = window.innerWidth;
            this.canvas.height = window.innerHeight;
        }
    },
    burst(x, y, count = 100) {
        if (!this.canvas) this.init();
        this.resize();
        
        const colors = ['#FF006E', '#00F5FF', '#FFBE0B', '#38A169', '#3182CE', '#E53E3E'];
        for (let i = 0; i < count; i++) {
            this.particles.push({
                x: x || window.innerWidth / 2,
                y: y || window.innerHeight / 2,
                vx: (Math.random() - 0.5) * 15,
                vy: (Math.random() - 0.75) * 15 - 5,
                size: Math.random() * 8 + 4,
                color: colors[Math.floor(Math.random() * colors.length)],
                rotation: Math.random() * 360,
                rotationSpeed: (Math.random() - 0.5) * 10,
                opacity: 1,
                decay: Math.random() * 0.015 + 0.008
            });
        }
        if (!this.animationFrame) {
            this.tick();
        }
    },
    tick() {
        if (!this.canvas) return;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        
        let alive = false;
        this.particles.forEach((p) => {
            if (p.opacity <= 0) return;
            alive = true;
            
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.28; // gravity
            p.vx *= 0.98; // air resistance
            p.rotation += p.rotationSpeed;
            p.opacity -= p.decay;
            
            this.ctx.save();
            this.ctx.translate(p.x, p.y);
            this.ctx.rotate(p.rotation * Math.PI / 180);
            this.ctx.fillStyle = p.color;
            this.ctx.globalAlpha = p.opacity;
            this.ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);
            this.ctx.restore();
        });
        
        if (alive) {
            this.animationFrame = requestAnimationFrame(() => this.tick());
        } else {
            this.animationFrame = null;
            this.particles = [];
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
        }
    }
};

// TOAST SYSTEM
function showToast(message, emoji = '💪') {
    const el = document.getElementById('toastAlert');
    if (!el) return;
    el.innerHTML = `${emoji} ${message}`;
    el.classList.add('active');
    setTimeout(() => {
        el.classList.remove('active');
    }, 3000);
}

// HEADER PROGRESS LOADER
function updateHeaderProgressBar() {
    const fill = document.getElementById('progressFillBar');
    const pctLabel = document.getElementById('progressPctText');
    const fracLabel = document.getElementById('progressFractionText');
    if (!fill) return;
    
    // Calculate workouts planned this week vs workouts logged this week
    const plannedCount = GymStore.schedule.filter(d => !d.rest).length;
    
    // Workouts logged this week (Monday to Sunday)
    const today = new Date();
    const currentDay = today.getDay(); // 0=Sun, 1=Mon, ..., 6=Sat
    const distanceToMonday = currentDay === 0 ? -6 : 1 - currentDay;
    
    const startOfWeek = new Date(today);
    startOfWeek.setDate(today.getDate() + distanceToMonday);
    startOfWeek.setHours(0,0,0,0);
    
    const loggedThisWeek = GymStore.history.filter(log => {
        const d = new Date(log.date);
        return d >= startOfWeek && log.type !== 'skipped';
    }).length;
    
    const pct = plannedCount > 0 ? Math.min(100, Math.round((loggedThisWeek / plannedCount) * 100)) : 0;
    
    fill.style.width = `${pct}%`;
    if (pctLabel) pctLabel.innerText = `Weekly Goal Consistency: ${pct}%`;
    if (fracLabel) fracLabel.innerText = `${loggedThisWeek}/${plannedCount} Workouts Logged`;
}

// REST & STIMULI TIMER SYNTHESIZER
let timerInterval = null;
let timerSecondsLeft = 0;
let timerTotalDuration = 90;
let isTimerRunning = false;

function toggleRestTimerWidget() {
    const w = document.getElementById('floatingTimerWidget');
    if (w) {
        w.style.display = 'flex';
    }
}
function closeRestTimerWidget() {
    clearInterval(timerInterval);
    isTimerRunning = false;
    document.getElementById('floatingTimerWidget').style.display = 'none';
}
function toggleTimerMinimize() {
    const w = document.getElementById('floatingTimerWidget');
    if (w) {
        w.classList.toggle('minimized');
    }
}
function setTimerDuration(seconds) {
    clearInterval(timerInterval);
    isTimerRunning = false;
    timerSecondsLeft = seconds;
    timerTotalDuration = seconds;
    updateTimerUI();
    const btn = document.getElementById('btnTimerStart');
    if (btn) btn.innerText = 'START';
}
function startTimer() {
    const btn = document.getElementById('btnTimerStart');
    if (isTimerRunning) {
        clearInterval(timerInterval);
        isTimerRunning = false;
        if (btn) btn.innerText = 'RESUME';
    } else {
        if (timerSecondsLeft <= 0) {
            timerSecondsLeft = timerTotalDuration;
        }
        isTimerRunning = true;
        if (btn) btn.innerText = 'PAUSE';
        
        timerInterval = setInterval(() => {
            timerSecondsLeft--;
            updateTimerUI();
            
            // Audio beeping warnings
            const audioOn = document.getElementById('timerAudioToggle').checked;
            if (audioOn) {
                if (timerSecondsLeft <= 3 && timerSecondsLeft > 0) {
                    playSynthesizedBeep(880, 0.08, 'sine'); // High warning beep
                } else if (timerSecondsLeft === 0) {
                    playTripleChime(); // End rest alarm
                }
            }
            
            if (timerSecondsLeft <= 0) {
                clearInterval(timerInterval);
                isTimerRunning = false;
                if (btn) btn.innerText = 'START';
                ConfettiEngine.burst(window.innerWidth - 100, window.innerHeight - 100, 30);
                showToast("Rest interval complete! Back to training.", "🔥");
            }
        }, 1000);
    }
}
function resetTimer() {
    clearInterval(timerInterval);
    isTimerRunning = false;
    timerSecondsLeft = timerTotalDuration;
    updateTimerUI();
    const btn = document.getElementById('btnTimerStart');
    if (btn) btn.innerText = 'START';
}
function updateTimerUI() {
    const mins = Math.floor(timerSecondsLeft / 60);
    const secs = timerSecondsLeft % 60;
    const str = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
    
    document.getElementById('timerDisplay').innerText = str;
    document.getElementById('timerMinText').innerText = str;
}

// BROWSER SYNTHESIZED SOUND GENERATOR (WEB AUDIO API)
function playSynthesizedBeep(frequency, duration, oscType = 'sine') {
    try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        const osc = ctx.createOscillator();
        const gainNode = ctx.createGain();
        
        osc.connect(gainNode);
        gainNode.connect(ctx.destination);
        
        osc.type = oscType;
        osc.frequency.value = frequency;
        
        gainNode.gain.setValueAtTime(0, ctx.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.2, ctx.currentTime + 0.02);
        gainNode.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + duration);
    } catch(e) {
        console.warn("AudioContext block:", e);
    }
}
function playTripleChime() {
    playSynthesizedBeep(523.25, 0.4, 'triangle'); // C5
    setTimeout(() => playSynthesizedBeep(659.25, 0.4, 'triangle'), 150); // E5
    setTimeout(() => playSynthesizedBeep(783.99, 0.6, 'sine'), 300); // G5
}

