<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Athlete's Power Plan — Apex Clinical Edition</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --crimson: #E53E3E;
    --crimson-glow: rgba(229, 62, 62, 0.12);
    --pull: #3182CE;
    --pull-glow: rgba(49, 130, 206, 0.12);
    --legs: #38A169;
    --legs-glow: rgba(56, 161, 105, 0.12);
    --rest: #718096;
    --bg: #F7FAFC;
    --card-bg: #FFFFFF;
    --border: #E2E8F0;
    --text: #2D3748;
    --text-dim: #718096;
    --container-border: #CBD5E0;
    --accent-glow: rgba(49, 130, 206, 0.2);
    --shadow: rgba(0,0,0,0.03);
    --header-glow: none;
    --btn-bg: #FFFFFF;
    --btn-text: #2D3748;
    --banner-bg: #EBF8FF;
    --banner-text: #2B6CB0;
    --card-hover-translate: -4px;
}

/* THEME: DARK CLINICAL */
body.theme-dark-clinical {
    --crimson: #FF3E3E;
    --crimson-glow: rgba(255, 62, 62, 0.25);
    --pull: #00D9FF;
    --pull-glow: rgba(0, 217, 255, 0.25);
    --legs: #39FF14;
    --legs-glow: rgba(57, 255, 20, 0.25);
    --rest: #5D6D7E;
    --bg: #0F1419;
    --card-bg: #151C24;
    --border: #24303F;
    --text: #F0F0F0;
    --text-dim: #85929E;
    --container-border: #2C3E50;
    --accent-glow: rgba(0, 217, 255, 0.35);
    --shadow: rgba(0,0,0,0.4);
    --header-glow: 0 0 15px rgba(0, 217, 255, 0.2);
    --btn-bg: #1B2631;
    --btn-text: #F0F0F0;
    --banner-bg: #1B4F72;
    --banner-text: #85C1E9;
}

/* THEME: WARM MINIMAL */
body.theme-warm-minimal {
    --crimson: #FF6B5B;
    --crimson-glow: rgba(255, 107, 91, 0.18);
    --pull: #8B6F47;
    --pull-glow: rgba(139, 111, 71, 0.18);
    --legs: #60997E;
    --legs-glow: rgba(96, 153, 126, 0.18);
    --rest: #A29B93;
    --bg: #FFF8F0;
    --card-bg: #FDF6EE;
    --border: #EAE0D5;
    --text: #2D2D2D;
    --text-dim: #7F6A5F;
    --container-border: #D5C3B0;
    --shadow: rgba(139, 111, 71, 0.05);
    --header-glow: none;
    --btn-bg: #FCF3EB;
    --btn-text: #2D2D2D;
    --banner-bg: #F9EBEA;
    --banner-text: #C0392B;
}

/* THEME: NEON SPORTS */
body.theme-neon-sports {
    --crimson: #FF006E;
    --crimson-glow: rgba(255, 0, 110, 0.28);
    --pull: #00F5FF;
    --pull-glow: rgba(0, 245, 255, 0.28);
    --legs: #FFBE0B;
    --legs-glow: rgba(255, 190, 11, 0.28);
    --rest: #5A5D7C;
    --bg: #121224;
    --card-bg: #1A1A35;
    --border: #2B2E58;
    --text: #FFFFFF;
    --text-dim: #8B8FA3;
    --container-border: #1E234A;
    --accent-glow: rgba(255, 0, 110, 0.35);
    --shadow: rgba(255, 0, 110, 0.15);
    --header-glow: 0 0 20px rgba(0, 245, 255, 0.3);
    --btn-bg: #23254A;
    --btn-text: #FFFFFF;
    --banner-bg: #4A154B;
    --banner-text: #F3C6F8;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    padding: 40px 20px;
    line-height: 1.3;
    overflow-x: hidden;
    transition: background 0.3s ease, color 0.3s ease;
}

/* Minimalist Dot Grid Background */
.dot-grid {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: radial-gradient(var(--border) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: -1;
    opacity: 0.7;
}

/* Header Section */
header {
    max-width: 1200px;
    margin: 0 auto 30px auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand .subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--pull);
}

.brand h1 {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.3rem, 5vw, 4.2rem);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text);
    line-height: 1.1;
}

.hud-stats {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
}

.stat-item {
    text-align: center;
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 10px 20px;
    border-radius: 12px;
    box-shadow: 0 4px 6px var(--shadow);
    min-width: 100px;
    transition: all 0.2s ease;
}
.stat-item:hover {
    transform: translateY(-2px);
    border-color: var(--pull);
}

.stat-item .label {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 3px;
}
.stat-item .value {
    font-family: 'Oswald', sans-serif;
    font-size: 1.6rem;
    color: var(--text);
}
.stat-item .value.active { color: var(--legs); }
.stat-item .value.streak { color: #FF6B5B; animation: pulseStreak 2s infinite ease-in-out; }

@keyframes pulseStreak {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.95; }
}

/* VOICE COUNTER SECTION */
.voice-counter-widget {
    max-width: 1200px;
    margin: 0 auto 30px auto;
    background: var(--card-bg);
    border: 2px solid var(--pull);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 8px 24px var(--shadow);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
}

@media (max-width: 768px) {
    .voice-counter-widget {
        grid-template-columns: 1fr;
        gap: 20px;
    }
}

.counter-display {
    text-align: center;
}

.counter-display .label {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-dim);
    margin-bottom: 12px;
    display: block;
}

.counter-numbers {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 24px;
}

.rep-box, .set-box {
    background: var(--bg);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 20px 28px;
    min-width: 140px;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.rep-box {
    border-color: var(--pull);
    box-shadow: 0 0 12px var(--pull-glow);
}

.rep-box.pulse {
    transform: scale(1.08);
    border-color: var(--pull);
    box-shadow: 0 0 24px var(--pull-glow);
}

.set-box {
    border-color: var(--legs);
    box-shadow: 0 0 12px var(--legs-glow);
}

.set-box.pulse {
    transform: scale(1.08);
    border-color: var(--legs);
    box-shadow: 0 0 24px var(--legs-glow);
}

.rep-box .sub-label, .set-box .sub-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin-bottom: 8px;
    display: block;
}

.rep-box .number, .set-box .number {
    font-family: 'Oswald', sans-serif;
    font-size: 4rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
}

.rep-box .number { color: var(--pull); }
.set-box .number { color: var(--legs); }

.counter-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.mic-status {
    background: var(--bg);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s ease;
    cursor: pointer;
}

.mic-status.active {
    border-color: var(--legs);
    box-shadow: 0 0 16px var(--legs-glow);
    background: rgba(56, 161, 105, 0.08);
}

.mic-status.listening {
    border-color: var(--pull);
    box-shadow: 0 0 16px var(--pull-glow);
    background: rgba(49, 130, 206, 0.08);
    animation: micPulse 1.5s ease-in-out infinite;
}

@keyframes micPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

.mic-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: currentColor;
    animation: none;
}

.mic-status.listening .mic-dot {
    animation: dotPulse 1.2s ease-in-out infinite;
}

@keyframes dotPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
}

.voice-transcript {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: var(--text-dim);
    min-height: 40px;
    display: flex;
    align-items: center;
    word-break: break-word;
}

.voice-transcript.active {
    color: var(--pull);
    border-color: var(--pull);
    background: rgba(49, 130, 206, 0.05);
}

.counter-button-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.counter-button-group .rest-btn {
    padding: 12px 16px;
    font-size: 0.9rem;
}

.counter-button-group .rest-btn.success {
    background: var(--legs);
    color: #000;
    border-color: var(--legs);
}

.counter-button-group .rest-btn.danger {
    background: var(--crimson);
    color: #fff;
    border-color: var(--crimson);
}

/* Control Bar */
.controls {
    max-width: 1200px;
    margin: 0 auto 30px auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

.controls .label {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-dim);
}

.rest-picker {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.rest-btn {
    background: var(--btn-bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 4px var(--shadow);
}

.rest-btn:hover {
    border-color: var(--text-dim);
    background: var(--border);
}

.rest-btn.active {
    background: var(--text);
    color: var(--card-bg);
    border-color: var(--text);
    box-shadow: 0 4px 10px var(--shadow);
}

/* Progress bar inside controls */
.progress-bar-container {
    max-width: 1200px;
    margin: 0 auto 20px auto;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    box-shadow: 0 4px 6px var(--shadow);
}
.progress-track {
    flex-grow: 1;
    background: var(--border);
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
}
.progress-fill {
    background: linear-gradient(90deg, var(--pull), var(--legs));
    height: 100%;
    width: 0%;
    transition: width 0.5s ease-out;
}

/* The Grid Container */
.grid-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px;
    border: 1px solid var(--container-border);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    box-shadow: 0 10px 30px var(--shadow);
}

.plan-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 25px;
}

/* Card Styling */
.day-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 25px;
    position: relative;
    border-top: 4px solid var(--accent);
    min-height: 290px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 4px 6px var(--shadow);
}

.day-card:hover { 
    transform: translateY(var(--card-hover-translate)); 
    box-shadow: 0 12px 25px var(--accent-glow);
    border-color: var(--accent);
}

.push { --accent: var(--crimson); --glow: var(--crimson-glow); }
.pull { --accent: var(--pull); --glow: var(--pull-glow); }
.legs { --accent: var(--legs); --glow: var(--legs-glow); }
.rest { --accent: var(--rest); --glow: transparent; }

@media (min-width: 1040px) {
    .rest { grid-column: 1 / 4; } 
}
@media (min-width: 710px) and (max-width: 1039px) {
    .rest { grid-column: 1 / 3; } 
}

/* Card Content Types */
.card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 25px;
}

.day-info { display: flex; align-items: baseline; gap: 8px; }
.day-name { font-family: 'Oswald', sans-serif; font-size: 1.5rem; letter-spacing: 1px; color: var(--text); }
.day-num { font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 700; color: var(--text-dim); }

.session-tag {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.65rem;
    color: var(--accent);
    background: var(--glow);
    padding: 4px 10px;
    border-radius: 4px;
    text-transform: uppercase;
}

.card-body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.muscle-group { display: flex; flex-direction: column; gap: 4px; }
.muscle-name {
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem;
    color: var(--text);
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.muscle-name::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
}

.rest .muscle-name::before { background: var(--rest); }

.muscle-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-dim);
    padding-left: 18px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.card-footer {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-start;
}

/* Interactive Muscle Groups */
.muscle-group.interactive {
    cursor: pointer;
    padding: 8px;
    margin: -8px;
    border-radius: 8px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}

.muscle-group.interactive:hover {
    background: var(--border);
    transform: translateX(4px);
}

/* Exercise Item Styling */
.exercise-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 15px;
    background: var(--btn-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.exercise-item:hover {
    border-color: var(--pull);
    background: var(--card-bg);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px var(--shadow);
}

.exercise-item .ex-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.exercise-item strong {
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
}

.exercise-item span {
    font-size: 0.8rem;
    color: var(--text-dim);
}

.exercise-item .time-badge {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.75rem;
    background: var(--border);
    padding: 4px 8px;
    border-radius: 4px;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 6px;
}

/* Video Player */
.video-wrapper {
    display: none;
    flex-direction: column;
    gap: 15px;
    margin-top: 15px;
}

.video-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 20px var(--shadow);
}

.video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.back-btn {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    padding: 8px 15px;
    border-radius: 6px;
    cursor: pointer;
    align-self: flex-start;
    font-size: 0.8rem;
    margin-bottom: 10px;
    transition: all 0.2s ease;
}

.back-btn:hover {
    background: var(--text);
    color: var(--card-bg);
}

/* Modal Styling */
.modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.modal-overlay.active {
    opacity: 1;
    pointer-events: all;
}

.modal-content {
    background: var(--card-bg);
    border: 1px solid var(--border);
    box-shadow: 0 20px 40px var(--shadow);
    border-radius: 16px;
    width: 92%;
    max-width: 650px;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    transform: translateY(20px);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.modal-overlay.active .modal-content {
    transform: translateY(0);
}

.modal-header {
    padding: 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg);
    border-radius: 16px 16px 0 0;
}

.modal-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.close-btn {
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-size: 1.7rem;
    cursor: pointer;
    transition: color 0.2s;
}
.close-btn:hover { color: var(--text); }

.modal-body {
    padding: 25px 30px;
    overflow-y: auto;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
}

/* Formatted Protocol Output Styles */
.modal-body ul { padding-left: 20px; margin: 15px 0 25px 0; }
.modal-body li { margin-bottom: 12px; border-bottom: 1px solid var(--bg); padding-bottom: 8px;}
.modal-body li:last-child { border-bottom: none; }
.modal-body strong { color: var(--text); font-family: 'Inter', sans-serif; font-weight: 700; font-size: 0.95rem; display: block; margin-bottom: 2px;}
.modal-body h3 { 
    font-family: 'Oswald', sans-serif; 
    color: inherit; 
    font-size: 1.4rem; 
    margin: 15px 0 10px 0; 
    letter-spacing: 1px;
    border-left: 4px solid currentColor;
    padding-left: 10px;
}

.loader {
    display: none;
    text-align: center;
    padding: 40px;
    font-family: 'Oswald', sans-serif;
    letter-spacing: 2px;
    animation: pulse 1.5s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

@media (max-width: 768px) {
    header { flex-direction: column; align-items: flex-start; gap: 20px; }
    .hud-stats { width: 100%; justify-content: flex-start; }
    .grid-container { padding: 15px; border: none; background: transparent; box-shadow: none; }
    .modal-body { padding: 15px; }
}

/* Navigation Tabs */
.nav-tab {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 10px 18px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.nav-tab:hover {
    border-color: var(--text);
    color: var(--text);
    background: var(--border);
}

.nav-tab.active {
    background: var(--text);
    color: var(--card-bg);
    border-color: var(--text);
    box-shadow: 0 4px 10px var(--shadow);
}

/* Edit Cog / Customize Button */
.btn-cog {
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 1.15rem;
    padding: 4px;
    border-radius: 4px;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-cog:hover {
    color: var(--text);
    background: var(--border);
    transform: rotate(45deg);
}

/* Calendar Styling */
.calendar-view-container {
    max-width: 1200px;
    margin: 0 auto;
}

.calendar-header-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding: 10px 20px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
}

.calendar-title-text {
    font-family: 'Oswald', sans-serif;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text);
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    margin-top: 15px;
}

.calendar-day-label {
    text-align: center;
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 10px 0;
}

.calendar-cell {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    min-height: 110px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    cursor: pointer;
    transition: all 0.2s ease;
}

.calendar-cell:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px var(--shadow);
    border-color: var(--text-dim);
}

.calendar-cell.other-month {
    opacity: 0.35;
}

.calendar-cell.today {
    border: 2px solid var(--pull);
}

.calendar-cell .cell-date {
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem;
    color: var(--text);
}

.calendar-cell .cell-workout {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    margin-top: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
}

.calendar-cell .workout-push { background: var(--crimson-glow); color: var(--crimson); }
.calendar-cell .workout-pull { background: var(--pull-glow); color: var(--pull); }
.calendar-cell .workout-legs { background: var(--legs-glow); color: var(--legs); }
.calendar-cell .workout-rest { background: var(--border); color: var(--text-dim); }
.calendar-cell .workout-custom { background: rgba(159, 122, 234, 0.15); color: #9F7AEA; }

.calendar-cell .cell-completed-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 20px;
    height: 20px;
    background: var(--legs);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    box-shadow: 0 2px 4px var(--shadow);
}

/* History Styling */
.history-view-container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.history-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px 25px;
    box-shadow: 0 4px 6px var(--shadow);
    transition: all 0.2s ease;
}

.history-card:hover {
    box-shadow: 0 8px 15px var(--accent-glow);
}

.history-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 15px;
}

.history-card-date {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    color: var(--text-dim);
}

.history-card-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.35rem;
    text-transform: uppercase;
    color: var(--text);
}

.history-exercises-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.history-exercise-row {
    background: var(--bg);
    border-radius: 8px;
    padding: 10px 15px;
    border: 1px solid var(--border);
}

.history-exercise-name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 4px;
}

.history-set-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.history-set-pill {
    font-size: 0.7rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 4px;
    color: var(--text);
    font-weight: 600;
}

.history-note-box {
    margin-top: 15px;
    padding: 12px 15px;
    background: rgba(49, 130, 206, 0.06);
    border-left: 3px solid var(--pull);
    border-radius: 0 8px 8px 0;
    font-size: 0.85rem;
    color: var(--text);
    line-height: 1.4;
}

.btn-delete-log {
    background: transparent;
    border: 1px solid transparent;
    color: var(--crimson);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
}

.btn-delete-log:hover {
    background: var(--crimson-glow);
    border-color: var(--crimson);
}

/* Logging Form Styling */
.logger-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.logger-exercises-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 25px;
}

.logger-exercise-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 15px;
    background: var(--bg);
}

.logger-exercise-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    color: var(--text);
    margin-bottom: 10px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
}

.logger-set-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 8px;
}

.logger-set-num {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--text-dim);
    width: 45px;
}

.logger-input-group {
    display: flex;
    align-items: center;
    gap: 6px;
}

.logger-input {
    width: 65px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    color: var(--text);
    background: var(--card-bg);
}

.logger-input:focus {
    outline: none;
    border-color: var(--pull);
}

.logger-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 600;
}

.btn-add-set, .btn-del-set {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
}

.btn-add-set:hover {
    background: var(--card-bg);
    color: var(--text);
    border-color: var(--text-dim);
}

.btn-del-set:hover {
    background: var(--crimson-glow);
    color: var(--crimson);
    border-color: var(--crimson);
}

.logger-textarea {
    width: 100%;
    height: 80px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    resize: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text);
    background: var(--card-bg);
    margin-top: 15px;
}

.logger-textarea:focus {
    outline: none;
    border-color: var(--pull);
}

/* Customize Plan Styling */
.customize-item-row {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
    background: var(--bg);
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
}

.btn-action-sm {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--text);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 6px 12px;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    transition: all 0.2s;
}

.btn-action-sm:hover {
    background: var(--text);
    color: var(--card-bg);
    border-color: var(--text);
}

.empty-state {
    text-align: center;
    padding: 30px 20px;
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem;
    color: var(--text-dim);
    letter-spacing: 1px;
    border: 2px dashed var(--border);
    border-radius: 12px;
    line-height: 1.4;
}

/* Confetti Canvas */
#confettiCanvas {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    z-index: 9999;
}

/* Floating Rest Timer */
.floating-timer-widget {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: var(--card-bg);
    border: 2px solid var(--pull);
    box-shadow: 0 10px 25px var(--shadow);
    border-radius: 16px;
    padding: 15px;
    z-index: 999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 220px;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.floating-timer-widget.minimized {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    padding: 0;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.floating-timer-widget.minimized .timer-full-content {
    display: none;
}
.floating-timer-widget.minimized .timer-min-content {
    display: flex;
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: bold;
    color: var(--pull);
    cursor: pointer;
}
.floating-timer-widget .timer-min-content {
    display: none;
}

/* Analytics SVGs */
.analytics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 25px;
    margin-top: 20px;
}
.analytics-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 4px 6px var(--shadow);
}
.analytics-card-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 15px;
    border-left: 3px solid var(--pull);
    padding-left: 8px;
}

/* Quiz Styling */
.quiz-welcome {
    text-align: center;
    padding: 10px 0;
}
.quiz-step-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 15px 0;
}
.quiz-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.3s;
}
.quiz-dot.active {
    background: var(--pull);
    width: 24px;
    border-radius: 4px;
}
.quiz-options-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 20px 0;
}
.quiz-option-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 15px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
}
.quiz-option-card:hover {
    border-color: var(--pull);
    background: var(--card-bg);
}
.quiz-option-card.selected {
    border-color: var(--pull);
    background: var(--pull-glow);
    color: var(--pull);
}

/* Toast alert notification */
.toast-notice {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(-100px);
    background: var(--text);
    color: var(--card-bg);
    padding: 12px 25px;
    border-radius: 30px;
    font-weight: 600;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    z-index: 10001;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    font-size: 0.9rem;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 8px;
}
.toast-notice.active {
    transform: translateX(-50%) translateY(0);
}

/* Achievement Badges styling */
.badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 15px;
    margin-top: 15px;
}
.badge-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 15px 10px;
    text-align: center;
    opacity: 0.4;
    transition: all 0.3s;
    filter: grayscale(100%);
}
.badge-card.unlocked {
    opacity: 1;
    filter: grayscale(0%);
    background: var(--card-bg);
    border-color: var(--legs);
    box-shadow: 0 4px 8px var(--legs-glow);
}
.badge-icon {
    font-size: 2.2rem;
    margin-bottom: 5px;
    display: block;
}
.badge-name {
    font-family: 'Oswald', sans-serif;
    font-size: 0.85rem;
    color: var(--text);
    text-transform: uppercase;
}
.badge-desc {
    font-size: 0.65rem;
    color: var(--text-dim);
    margin-top: 3px;
    line-height: 1.2;
}

/* Preview plan sharing banner */
.preview-banner {
    background: var(--banner-bg);
    border: 1px solid var(--banner-text);
    color: var(--banner-text);
    padding: 12px 20px;
    border-radius: 12px;
    max-width: 1200px;
    margin: 0 auto 20px auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-weight: 600;
    box-shadow: 0 4px 6px var(--shadow);
}

/* Interactive SVG graph bar elements */
.svg-bar {
    cursor: pointer;
    transition: fill 0.2s, filter 0.2s;
}
.svg-bar:hover {
    fill: var(--pull);
    filter: drop-shadow(0 0 4px var(--accent-glow));
}

@media print {
    body { background: white; color: black; padding: 0; }
    header, .controls, .floating-timer-widget, #confettiCanvas, .progress-bar-container, footer, .btn-action-sm { display: none !important; }
    .grid-container { border: none; padding: 0; box-shadow: none; }
    .day-card { border: 1px solid #000 !important; page-break-inside: avoid; }
}
</style>
</head>
<body class="theme-slate-light">

<div class="dot-grid"></div>
<canvas id="confettiCanvas"></canvas>

<!-- Top Alert Toast -->
<div id="toastAlert" class="toast-notice">💪 Session Recorded successfully!</div>

<!-- Shared plan preview banner -->
<div id="sharedPreviewBanner" class="preview-banner" style="display: none;">
    <div style="display: flex; align-items: center; gap: 8px;">
        <span>🔗 PREVIEWING SHARED PROTOCOL: You loaded a custom schedule from a training partner!</span>
    </div>
    <div style="display: flex; gap: 10px;">
        <button class="rest-btn" onclick="importSharedPlan()" style="padding: 6px 12px; font-size: 0.75rem; background: var(--banner-text); color: var(--card-bg); border-color: var(--banner-text);">Apply to My Schedule</button>
        <button class="rest-btn" onclick="cancelPreviewPlan()" style="padding: 6px 12px; font-size: 0.75rem; background: transparent; border-color: var(--banner-text); color: var(--banner-text);">Cancel</button>
    </div>
</div>

<header>
    <div class="brand">
        <div class="subtitle">Peak Physiology Protocol</div>
        <h1>Power Plan</h1>
    </div>
    <div class="hud-stats">
        <div class="stat-item" style="cursor: pointer;" onclick="openAchievementsModal()" title="View Achievements & Streaks">
            <div class="label">Streak</div>
            <div class="value streak" id="hudStreak">🔥 0 Days</div>
        </div>
        <div class="stat-item" style="cursor: pointer;" onclick="openAchievementsModal()" title="Streak Protection skip cards remaining">
            <div class="label">Skip Cards</div>
            <div class="value" id="hudSkipCards" style="color: var(--crimson);">⚡ 1/1</div>
        </div>
        <div class="stat-item">
            <div class="label">Total Logged</div>
            <div class="value active" id="hudLoggedCount">0</div>
        </div>
    </div>
</header>

<!-- Progress Bar -->
<div class="progress-bar-container">
    <div class="label" id="progressPctText">Weekly Goal Progress: 0%</div>
    <div class="progress-track">
        <div class="progress-fill" id="progressFillBar"></div>
    </div>
    <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-dim);" id="progressFractionText">0/6 Workouts Completed</div>
</div>

<!-- VOICE COUNTER WIDGET -->
<div class="voice-counter-widget" id="voiceCounterWidget">
    <div class="counter-display">
        <span class="label">Rep & Set Counter</span>
        <div class="counter-numbers">
            <div class="rep-box" id="repBoxDisplay">
                <span class="sub-label">Current Rep</span>
                <div class="number" id="repCount">0</div>
                <div style="display: flex; gap: 6px; justify-content: center; margin-top: 12px;">
                    <button onclick="decrementRep()" class="rest-btn" style="padding: 6px 12px; font-size: 0.9rem; flex: 1;">−</button>
                    <button onclick="incrementRep()" class="rest-btn" style="padding: 6px 12px; font-size: 0.9rem; flex: 1;">+</button>
                </div>
            </div>
            <div class="set-box" id="setBoxDisplay">
                <span class="sub-label">Set</span>
                <div class="number" id="setCount">0</div>
                <div style="display: flex; gap: 6px; justify-content: center; margin-top: 12px;">
                    <button onclick="decrementSet()" class="rest-btn" style="padding: 6px 12px; font-size: 0.9rem; flex: 1;">−</button>
                    <button onclick="incrementSet()" class="rest-btn" style="padding: 6px 12px; font-size: 0.9rem; flex: 1;">+</button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="counter-controls">
        <div class="mic-status" id="micStatus" onclick="toggleVoiceCounter()">
            <span class="mic-dot"></span>
            <span id="micStatusText">🎤 Tap to Start Listening</span>
        </div>
        
        <div class="voice-transcript" id="voiceTranscript">Waiting for input...</div>
        
        <div class="counter-button-group">
            <button class="rest-btn success" onclick="nextSet()">✓ Next Set</button>
            <button class="rest-btn danger" onclick="resetCounter()">↺ Reset All</button>
        </div>
    </div>
</div>

<div class="controls">
    <!-- View Switcher Tabs -->
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <button id="btnTabWeek" class="nav-tab active" onclick="switchTab('week')">Weekly Plan</button>
        <button id="btnTabCalendar" class="nav-tab" onclick="switchTab('calendar')">Calendar</button>
        <button id="btnTabHistory" class="nav-tab" onclick="switchTab('history')">History Logs</button>
        <button id="btnTabAnalytics" class="nav-tab" onclick="switchTab('analytics')">Analytics</button>
    </div>
    
    <!-- Theme & Settings Controls -->
    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <div id="restPickerContainer" style="display: flex; align-items: center; gap: 8px;">
            <div class="label">Rest:</div>
            <div class="rest-picker" id="restPicker"></div>
        </div>
        
        <!-- Theme Dropdown selector -->
        <select id="themeSelector" class="rest-btn" onchange="changeTheme(this.value)" style="height: auto; padding: 6px 12px; font-weight: 700; font-size: 0.8rem;">
            <option value="slate-light">☀️ Slate Light</option>
            <option value="dark-clinical">🌙 Dark Clinical</option>
            <option value="warm-minimal">🪵 Warm Minimal</option>
            <option value="neon-sports">⚡ Neon Sports</option>
        </select>
        
        <button onclick="openShortcutsModal()" class="rest-btn" style="padding: 6px 10px; font-size: 0.8rem;" title="View Keyboard Shortcuts">⌨️ Keyboard</button>
    </div>
</div>

<main class="grid-container">
    <!-- WEEKLY PLAN VIEW -->
    <div id="weekView" class="tab-content">
        <div class="plan-grid" id="mainGrid">
            <!-- JS Injection -->
        </div>
    </div>
    
    <!-- CALENDAR VIEW -->
    <div id="calendarView" class="tab-content" style="display: none;">
        <div class="calendar-view-container">
            <div class="calendar-header-controls">
                <button class="rest-btn" onclick="changeMonth(-1)">◀ PREV</button>
                <div class="calendar-title-text" id="calendarTitle">MAY 2026</div>
                <button class="rest-btn" onclick="changeMonth(1)">NEXT ▶</button>
            </div>
            <div class="calendar-grid">
                <div class="calendar-day-label">Mon</div>
                <div class="calendar-day-label">Tue</div>
                <div class="calendar-day-label">Wed</div>
                <div class="calendar-day-label">Thu</div>
                <div class="calendar-day-label">Fri</div>
                <div class="calendar-day-label">Sat</div>
                <div class="calendar-day-label">Sun</div>
            </div>
            <div class="calendar-grid" id="calendarGridCells">
                <!-- JS Injection -->
            </div>
        </div>
    </div>
    
    <!-- HISTORY VIEW -->
    <div id="historyView" class="tab-content" style="display: none;">
        <div style="display: flex; justify-content: flex-end; gap: 15px; margin-bottom: 20px;">
            <button class="rest-btn" onclick="window.print()" style="font-size: 0.8rem;">🖨️ PDF Print Checklist</button>
            <button class="rest-btn" onclick="exportCalendarICS()" style="font-size: 0.8rem;">📅 Export iCal (.ics)</button>
            <button class="rest-btn" onclick="shareAccountabilityLink()" style="font-size: 0.8rem;">🔗 Copy Partner Link</button>
            <button class="rest-btn" onclick="exportSummaryPNG()" style="font-size: 0.8rem;">🖼️ Export PNG Card</button>
        </div>
        <div class="history-view-container" id="historyContainer">
            <!-- JS Injection -->
        </div>
    </div>
    
    <!-- ANALYTICS & PROGRESS VIEW -->
    <div id="analyticsView" class="tab-content" style="display: none;">
        <div class="analytics-grid">
            <!-- 1. Circular Completion Ring -->
            <div class="analytics-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                <div class="analytics-card-title" style="align-self: flex-start; width: 100%;">Weekly Consistency Ring</div>
                <div style="position: relative; width: 150px; height: 150px; margin: 15px 0;">
                    <svg width="150" height="150" viewBox="0 0 150 150">
                        <circle cx="75" cy="75" r="60" fill="transparent" stroke="var(--border)" stroke-width="12"></circle>
                        <circle cx="75" cy="75" r="60" fill="transparent" stroke="var(--pull)" stroke-width="12" stroke-dasharray="376.99" stroke-dashoffset="376.99" id="analyticsRingProgress" stroke-linecap="round" transform="rotate(-90 75 75)" style="transition: stroke-dashoffset 0.8s ease-out;"></circle>
                    </svg>
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: 'Oswald', sans-serif; font-size: 1.8rem; font-weight: bold;" id="analyticsPctLabel">0%</div>
                </div>
                <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-dim);" id="analyticsDetailLabel">0 out of 0 days completed this week</div>
            </div>
            
            <!-- 2. Volume Trend Bar Chart -->
            <div class="analytics-card">
                <div class="analytics-card-title">Rolling Volume Trends (Total Load)</div>
                <div id="volumeChartContainer" style="width: 100%; height: 160px; display: flex; align-items: flex-end; justify-content: space-around; padding-bottom: 20px; border-bottom: 2px solid var(--border);">
                    <!-- Dynamic Bars drawn via JS -->
                </div>
                <div style="display: flex; justify-content: space-around; margin-top: 10px; font-size: 0.75rem; font-weight: bold; color: var(--text-dim);">
                    <div>3 Wks Ago</div>
                    <div>2 Wks Ago</div>
                    <div>Last Week</div>
                    <div>This Week</div>
                </div>
            </div>
            
            <!-- 3. Muscle Split Graph -->
            <div class="analytics-card">
                <div class="analytics-card-title">Muscle Target Volumetric Share</div>
                <div id="muscleDistributionChart" style="display: flex; flex-direction: column; gap: 12px; margin-top: 10px;">
                    <!-- JS Injection -->
                </div>
            </div>
        </div>
        
        <!-- AI Coach Widget Card -->
        <div class="analytics-card" style="margin-top: 25px; background: linear-gradient(135deg, var(--card-bg), var(--pull-glow)); border-color: var(--pull);">
            <div class="analytics-card-title" style="border-color: var(--legs);">🧬 Dynamic Physiology Coach Recommendation</div>
            <div style="display: flex; gap: 15px; align-items: flex-start; margin-top: 10px;">
                <span style="font-size: 2.2rem;">🤖</span>
                <div>
                    <h4 style="font-family: 'Oswald', sans-serif; font-size: 1.1rem; text-transform: uppercase; margin-bottom: 5px; color: var(--text);">Coach Advisory:</h4>
                    <p id="aiCoachText" style="font-size: 0.9rem; color: var(--text); line-height: 1.4; font-weight: 500;">
                        Analyzing your baseline schedule to generate tailored fatiguing thresholds. Complete a workout to trigger localized anatomical metrics.
                    </p>
                </div>
            </div>
        </div>
    </div>
</main>

