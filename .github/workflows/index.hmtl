            01:30
        </div>
        
        <!-- Timer Quick Select presets -->
        <div style="display: flex; justify-content: space-between; gap: 4px; margin-bottom: 10px;">
            <button onclick="setTimerDuration(30)" style="padding: 4px; font-size: 0.65rem; flex:1;" class="rest-btn">30s</button>
            <button onclick="setTimerDuration(60)" style="padding: 4px; font-size: 0.65rem; flex:1;" class="rest-btn">60s</button>
