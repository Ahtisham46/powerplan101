        t2: "SHOULDERS 2",
        ex2: [
            { name: "Cheat Lateral", desc: "Heavy mechanical overload", time: "5:15", start: 315 },
            { name: "Inclined Front Raise", desc: "Anterior delt stretch", time: "6:05", start: 365 },
            { name: "Facepull", desc: "Postural alignment finisher", time: "7:05", start: 425 }
        ]
