function selectQuizOption(key, val) {
    quizAnswers[key] = val;
    playSynthesizedBeep(659.25, 0.05, 'sine');
    
    if (quizStep < 5) {
        quizStep++;
        renderQuizStep();
    } else {
        generateQuizPlan();
    }
}

function goBackQuizStep() {
    if (quizStep > 1) {
        quizStep--;
        renderQuizStep();
    }
}

function generateQuizPlan() {
    GymStore.onboarded = true;
    GymStore.theme = quizAnswers.theme;
    
    // Map frequency days selection
    const daysAvailable = parseInt(quizAnswers.freq);
    GymStore.schedule = [];
    
    let activeWIdx = 0;
    
    // Build schedule based on weekly training count
    DAYS.forEach((day, i) => {
        let isRest = false;
        
        if (daysAvailable === 3) {
            // Monday, Wednesday, Friday active. Rest others.
            if (i !== 0 && i !== 2 && i !== 4) isRest = true;
        } else if (daysAvailable === 4) {
            // Mon, Tue, Thu, Fri active. Rest Wed, Sat, Sun.
            if (i === 2 || i === 5 || i === 6) isRest = true;
        } else if (daysAvailable === 5) {
            // Mon, Tue, Wed, Fri, Sat active. Rest Thu, Sun.
            if (i === 3 || i === 6) isRest = true;
        } else {
            // 6 days active. Sunday rest.
            if (i === 6) isRest = true;
        }
        
        if (isRest) {
            GymStore.schedule.push({
                type: 'rest',
                name: 'Rest Day',
                dbIndex: -1,
                m1: 'REST',
                sub1: 'RECOVERY DAY',
                m2: '',
                sub2: '',
                rest: true,
                customExercises: null
            });
        } else {
            const w = WORKOUTS[activeWIdx] || WORKOUTS[0];
            let displayName = '';
            if (w.type === 'push') displayName = w.m1 === 'CHEST' && w.sub1.includes('Upper') ? 'Push 1' : 'Push 2';
            else if (w.type === 'pull') displayName = w.m1 === 'BACK' && w.sub1.includes('Width') ? 'Pull 1' : 'Pull 2';
            else displayName = w.m1 === 'LEGS' && w.sub1.includes('Posterior') ? 'Legs 1 & Shoulders 1' : 'Legs 2 & Shoulders 2';
            
            // Adjust exercises for Equipment preferences
            let finalExercises = null;
            if (quizAnswers.equip !== 'gym') {
                const dbEx = PROTOCOL_DB[activeWIdx];
                if (dbEx) {
                    const merged = [...(dbEx.ex1 || []), ...(dbEx.ex2 || [])];
                    finalExercises = merged.map(ex => {
                        let name = ex.name;
                        let desc = ex.desc;
                        if (quizAnswers.equip === 'home') {
                            // Dumbbell & band equivalents
                            if (name.includes('Barbell') || name.includes('BB')) name = name.replace(/Barbell|BB/g, 'DB');
                            if (name.includes('Pulldown') || name.includes('Row') || name.includes('Crossover')) {
                                desc = "Adapted for Resistance Bands: " + desc;
                            }
                        } else {
                            // Bodyweight equivalents
                            if (name.includes('Bench Press') || name.includes('Press')) name = "Tension Pushup Variation";
                            if (name.includes('Squat')) name = "Deep Bodyweight Squat (Tension)";
                            if (name.includes('Deadlift')) name = "Hamstring Bridge Walkouts";
                            desc = "Bodyweight Adaptive: " + desc;
                        }
                        return { name, desc, time: ex.time, start: ex.start };
                    });
                }
            }
            
            GymStore.schedule.push({
                type: w.type,
                name: displayName,
                dbIndex: activeWIdx,
                m1: w.m1,
                sub1: w.sub1,
                m2: w.m2,
                sub2: w.sub2,
                rest: false,
                customExercises: finalExercises
            });
            activeWIdx++;
        }
    });
    
    // Save, switch theme, close modal
    saveStore();
    applyTheme();
    closeModal();
    
    // Set matching dropdown
    const sel = document.getElementById('themeSelector');
    if (sel) sel.value = GymStore.theme;
    
    renderGrid();
    renderPicker();
    ConfettiEngine.burst(window.innerWidth / 2, window.innerHeight / 2, 120);
    showToast("Athletic profile established! Custom plan generated.", "🧬");
}

// THEME TOGGLES
