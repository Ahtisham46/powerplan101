    GymStore.theme = themeVal;
    saveStore();
    applyTheme();
}

function applyTheme() {
    document.body.classList.remove('theme-slate-light', 'theme-dark-clinical', 'theme-warm-minimal', 'theme-neon-sports');
    document.body.classList.add(`theme-${GymStore.theme}`);
}

// --- RENDERS PICKERS & GRIDS ---
function renderPicker() {
    const picker = document.getElementById('restPicker');
    if (picker) {
        picker.innerHTML = DAYS.map((d, i) => `
            <button class="rest-btn ${i === currentRestDay ? 'active' : ''}" onclick="updateRest(${i})">
                ${d.substring(0, 3)}
            </button>
        `).join('');
    }
}

function updateRest(dayIdx) {
    const oldRestDay = GymStore.schedule.findIndex(d => d.rest);
    if (oldRestDay !== -1 && oldRestDay !== dayIdx) {
        const temp = GymStore.schedule[dayIdx];
        GymStore.schedule[dayIdx] = GymStore.schedule[oldRestDay];
        GymStore.schedule[oldRestDay] = temp;
        
        currentRestDay = dayIdx;
    }
    saveStore();
    renderPicker();
    renderGrid();
    renderCalendar();
}

function renderGrid() {
    const grid = document.getElementById('mainGrid');
    if (!grid) return;
    grid.innerHTML = '';

    let dayNum = 1;
    let counts = { push: 0, pull: 0, legs: 0 };

    GymStore.schedule.forEach((dayConfig, i) => {
        const card = document.createElement('div');
        const dayName = DAYS[i];
        
        // Check if completed today in history to render visual checkmark
        const dateStr = getTodayISOString();
        const completedLogs = GymStore.history.filter(h => h.date === dateStr && h.name === (dayConfig.name || dayConfig.type.toUpperCase()));
        const isDoneToday = completedLogs.length > 0;
        
        if (dayConfig.rest) {
            card.className = `day-card rest`;
            card.innerHTML = `
                <div class="card-header">
                    <div class="day-info">
                        <span class="day-name">${dayName}</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="session-tag">SYSTEM IDLE</span>
                        <button class="btn-cog" onclick="openCustomizeModal(${i})" title="Customize Day">⚙️</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="muscle-group">
                        <div class="muscle-name">${dayConfig.m1}</div>
                        <div class="muscle-desc">${dayConfig.sub1}</div>
                    </div>
                </div>
                <div class="card-footer" style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-top:20px; border-top:1px solid var(--border); padding-top:10px;">
                    <button class="rest-btn" style="padding: 6px 12px; font-size: 0.75rem;" onclick="openProtocolModal('rest', 'rest', 'Rest & Recovery')">🧬 RECOVERY</button>
                    <button class="rest-btn" style="padding: 6px 12px; font-size: 0.75rem; border-color:var(--pull); color:var(--pull);" onclick="toggleRestTimerWidget()">⏱️ START TIMER</button>
                </div>
            `;
        } else {
            counts[dayConfig.type] = (counts[dayConfig.type] || 0) + 1;
            const currentCount = counts[dayConfig.type];
            const formattedDayNum = String(dayNum).padStart(2, '0');

            let cardTypeClass = dayConfig.type;
            if (cardTypeClass === 'custom') {
                if (dayConfig.name.toLowerCase().includes('push')) cardTypeClass = 'push';
                else if (dayConfig.name.toLowerCase().includes('pull')) cardTypeClass = 'pull';
                else if (dayConfig.name.toLowerCase().includes('legs')) cardTypeClass = 'legs';
                else cardTypeClass = 'pull';
            }

            card.className = `day-card ${cardTypeClass}`;
            
            const accentColors = { push: 'var(--crimson)', pull: 'var(--pull)', legs: 'var(--legs)' };
            const accent = accentColors[cardTypeClass] || 'var(--pull)';

            card.innerHTML = `
                <div class="card-header">
                    <div class="day-info">
                        <span class="day-name">${dayName}</span>
                        <span class="day-num">| ${formattedDayNum}</span>
                        ${isDoneToday ? `<span style="color:var(--legs); font-weight:bold; font-size:1.1rem; margin-left:6px;" title="Completed today!">✓</span>` : ''}
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="session-tag">${dayConfig.type === 'custom' ? 'CUSTOM' : 'REBUILDING'}</span>
                        <button class="btn-cog" onclick="openCustomizeModal(${i})" title="Customize Day">⚙️</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="muscle-group interactive" onclick="openExerciseList(${i}, 1, '${cardTypeClass}')">
                        <div class="muscle-name">${dayConfig.m1} ${dayConfig.type === 'custom' ? '' : currentCount}</div>
                        <div class="muscle-desc">${dayConfig.sub1}</div>
                    </div>
                    ${dayConfig.m2 ? `
                    <div class="muscle-group interactive" onclick="openExerciseList(${i}, 2, '${cardTypeClass}')">
                        <div class="muscle-name">${dayConfig.m2} ${dayConfig.type === 'custom' ? '' : currentCount}</div>
                        <div class="muscle-desc">${dayConfig.sub2}</div>
                    </div>` : ''}
                </div>
                <div class="card-footer" style="display: flex; flex-direction: column; gap: 10px; width: 100%; margin-top: 15px; border-top: 1px solid var(--border); padding-top: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Click Target for Videos</span>
                        <button onclick="startWorkoutSession(${i})" style="background:transparent; border:none; cursor:pointer; font-size:0.9rem;" title="Set-by-Set Logging Track">📝</button>
                    </div>
                    <div style="display: flex; gap: 8px; width: 100%;">
                        <button class="rest-btn" onclick="quickLogWorkout(${i}, 'done', event)" style="flex: 2; padding: 6px; font-size: 0.75rem; border-color: var(--legs); color: var(--legs); font-weight:700;">✓ QUICK DONE</button>
                        <button class="rest-btn" onclick="quickLogWorkout(${i}, 'skip', event)" style="flex: 1; padding: 6px; font-size: 0.75rem; border-color: var(--rest); color: var(--text-dim);">SKIP</button>
                    </div>
                </div>
            `;
            dayNum++;
        }
        
        grid.appendChild(card);
    });
}

function getTodayISOString() {
    return new Date().toISOString().split('T')[0];
}

// STREAK & ACHIEVEMENTS SYSTEM
function calculateStreakValue() {
    if (GymStore.history.length === 0) {
        GymStore.streak = 0;
        saveStore();
        return;
    }
    
    // Sort unique activity dates descending
    const dates = [...new Set(GymStore.history.map(h => h.date))].sort().reverse();
    const todayStr = getTodayISOString();
    
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    const yesterdayStr = yesterday.toISOString().split('T')[0];
    
    // Streak is alive if logged today, yesterday, or protected by skip
    if (dates[0] !== todayStr && dates[0] !== yesterdayStr) {
        GymStore.streak = 0;
    } else {
        let streak = 1;
        for (let i = 0; i < dates.length - 1; i++) {
            const d1 = new Date(dates[i]);
            const d2 = new Date(dates[i+1]);
            const diffDays = Math.ceil(Math.abs(d1 - d2) / (1000 * 60 * 60 * 24));
            
            if (diffDays === 1) {
                streak++;
            } else {
                // If there's a skipped log with protection, we can bridge it
                // To keep calculation clean, we look if there's a skip log in history
                const skippedOnThatDate = GymStore.history.find(h => {
                    const logDate = new Date(h.date);
                    return logDate > d2 && logDate < d1 && h.type === 'skipped' && h.protected;
                });
                
                if (skippedOnThatDate) {
                    streak++;
                } else {
                    break;
                }
            }
        }
        GymStore.streak = streak;
    }
    
    if (GymStore.streak > GymStore.longestStreak) {
        GymStore.longestStreak = GymStore.streak;
    }
    saveStore();
}

function openAchievementsModal() {
    modal.classList.add('active');
    modalBody.innerHTML = '';
    loader.style.display = 'block';
    
    modalTitle.innerHTML = `🔥 Gamified Streak & Badges Command Center`;
    modalTitle.style.color = '#FF6B5B';
    
    setTimeout(() => {
        loader.style.display = 'none';
        
        // Check unlocked states
        const firstLog = GymStore.history.length > 0;
        const streak3 = GymStore.streak >= 3;
        const totalLogs = GymStore.history.length;
        const isLegsLogged = GymStore.history.some(h => h.name.toLowerCase().includes('legs'));
        const volumeHigh = GymStore.history.some(h => {
            let sVol = 0;
            h.exercises.forEach(ex => ex.sets.forEach(s => sVol += s.weight * s.reps));
            return sVol > 1000;
        });
        
        let html = `
            <div style="background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:20px; text-align:center; margin-bottom:20px;">
                <div style="font-size:3.5rem; margin-bottom:5px;">🔥</div>
                <h2 style="font-family:'Oswald',sans-serif; font-size:2rem; text-transform:uppercase; color:var(--text);">${GymStore.streak} Days Active Streak</h2>
                <p style="font-size:0.85rem; color:var(--text-dim); font-weight:700;">ALL-TIME LONGEST RECORD: ${GymStore.longestStreak} DAYS</p>
                
                <div style="border-top:1px solid var(--border); margin-top:15px; padding-top:15px; display:flex; justify-content:space-around; align-items:center; flex-wrap:wrap; gap:10px;">
                    <div>
                        <div style="font-size:1.1rem; font-weight:bold; color:var(--text);">${GymStore.skipCards}/1</div>
                        <div style="font-size:0.75rem; color:var(--text-dim);">Streak Protection Skips</div>
                    </div>
                    <div>
                        <button class="rest-btn" onclick="activateStreakProtection()" style="font-size:0.8rem; border-color:var(--crimson); color:var(--crimson);">⚡ Use Skip Card</button>
                    </div>
                </div>
                <p style="font-size:0.7rem; color:var(--text-dim); margin-top:8px; line-height:1.2;">
                    <strong>Rule:</strong> Skip Cards allow you to miss a training day without breaking your consecutive streak. Resets automatically at the start of each month!
                </p>
            </div>
            
            <h3 style="color:var(--pull); font-size:1.2rem; border-color:var(--pull);">UNLOCKED PERFORMANCE SHARDS:</h3>
            <div class="badge-grid">
                <div class="badge-card ${firstLog ? 'unlocked' : ''}">
                    <span class="badge-icon">🎯</span>
                    <span class="badge-name">First Step</span>
                    <span class="badge-desc">Logged your first training session</span>
                </div>
                <div class="badge-card ${streak3 ? 'unlocked' : ''}">
                    <span class="badge-icon">⚡</span>
                    <span class="badge-name">Consistent</span>
                    <span class="badge-desc">Reached a 3-day active streak</span>
                </div>
                <div class="badge-card ${totalLogs >= 5 ? 'unlocked' : ''}">
                    <span class="badge-icon">🎖️</span>
                    <span class="badge-name">Veteran</span>
                    <span class="badge-desc">Completed 5+ total logs</span>
                </div>
                <div class="badge-card ${isLegsLogged ? 'unlocked' : ''}">
                    <span class="badge-icon">🦵</span>
                    <span class="badge-name">Leg Day Hero</span>
                    <span class="badge-desc">Logged quad/hamstring Compound</span>
                </div>
                <div class="badge-card ${volumeHigh ? 'unlocked' : ''}">
                    <span class="badge-icon">🌋</span>
                    <span class="badge-name">Iron Load</span>
                    <span class="badge-desc">Lifting >1,000kg load in 1 session</span>
                </div>
                <div class="badge-card ${GymStore.theme !== 'slate-light' ? 'unlocked' : ''}">
                    <span class="badge-icon">🎨</span>
                    <span class="badge-name">Aesthetician</span>
                    <span class="badge-desc">Customized your dashboard theme</span>
                </div>
            </div>
            
            <div style="margin-top:25px; display:flex; justify-content:flex-end;">
                <button class="rest-btn" onclick="closeModal()">Close</button>
            </div>
        `;
        modalBody.innerHTML = html;
    }, 200);
}

function activateStreakProtection() {
    if (GymStore.skipCards <= 0) {
        alert("You have no Skip Cards remaining for this month!");
        return;
    }
    
    // Log a skipped entry for yesterday or today
    const dateStr = getTodayISOString();
    
    const skipLog = {
        id: Date.now(),
        date: dateStr,
        type: 'skipped',
        name: 'Streak Protected Skip',
        exercises: [],
        notes: 'Streak protection skip card activated to preserve consecutive daily training streak.',
        protected: true
    };
    
    GymStore.history.unshift(skipLog);
    GymStore.skipCards--;
    
    saveStore();
    calculateStreakValue();
    closeModal();
    
    ConfettiEngine.burst(window.innerWidth / 2, window.innerHeight / 2, 50);
    showToast("Streak Protected Skip card applied!", "⚡");
    
    renderGrid();
    renderCalendar();
    renderHistory();
}

// FRICTIONLESS QUICK WORKOUT LOGGING
function quickLogWorkout(dayIndex, status, event) {
    if (event) event.stopPropagation();
    
    const dayConfig = GymStore.schedule[dayIndex];
    if (dayConfig.rest) return;
    
    const dateStr = getTodayISOString();
    
    if (status === 'skip') {
        const skipLog = {
            id: Date.now(),
            date: dateStr,
            type: 'skipped',
            name: dayConfig.name || dayConfig.type.toUpperCase(),
            exercises: [],
            notes: 'Skipped workout scheduled for this day.',
            protected: false
        };
        GymStore.history.unshift(skipLog);
        saveStore();
        calculateStreakValue();
        showToast("Logged as Skipped.", "➔");
    } else {
        // Quick complete - generates default logs
        let exercises = [];
        if (dayConfig.customExercises) {
            exercises = dayConfig.customExercises;
        } else {
            const dbData = PROTOCOL_DB[dayConfig.dbIndex];
            if (dbData) {
                exercises = [...(dbData.ex1 || []), ...(dbData.ex2 || [])];
            }
        }
        
        const loggedExercises = exercises.map(ex => ({
            name: ex.name,
            desc: ex.desc,
            sets: [
                { set: 1, weight: 20, reps: 10 },
                { set: 2, weight: 20, reps: 10 },
                { set: 3, weight: 20, reps: 10 }
            ]
        }));
        
        const historyItem = {
            id: Date.now(),
            date: dateStr,
            type: dayConfig.type,
            name: dayConfig.name || dayConfig.type.toUpperCase(),
            exercises: loggedExercises,
            notes: 'Quick logged session with baseline tension volume metrics.'
        };
        
        GymStore.history.unshift(historyItem);
        saveStore();
        calculateStreakValue();
        
        // Explode Confetti!
        const btnRect = event ? event.target.getBoundingClientRect() : null;
        const x = btnRect ? btnRect.left + btnRect.width/2 : window.innerWidth/2;
        const y = btnRect ? btnRect.top + btnRect.height/2 : window.innerHeight/2;
        ConfettiEngine.burst(x, y, 100);
        playTripleChime();
        
        showToast("Session Recorded successfully! 🔥", "🎉");
    }
    
    renderGrid();
    renderCalendar();
    renderHistory();
    renderAnalyticsDashboard();
}

// FULL LOGGER MODAL
function startWorkoutSession(dayIndex, specificDate = null) {
    const dayConfig = GymStore.schedule[dayIndex];
    if (dayConfig.rest) return;

    modal.classList.add('active');
    modalBody.innerHTML = '';
    loader.style.display = 'block';
    
    let displayType = dayConfig.type;
    if (displayType === 'custom') {
        if (dayConfig.name.toLowerCase().includes('push')) displayType = 'push';
        else if (dayConfig.name.toLowerCase().includes('pull')) displayType = 'pull';
        else if (dayConfig.name.toLowerCase().includes('legs')) displayType = 'legs';
    }
    
    const colors = { push: 'var(--crimson)', pull: 'var(--pull)', legs: 'var(--legs)', rest: 'var(--text)', custom: '#9F7AEA' };
    const color = colors[displayType] || 'var(--text)';
    
    modalTitle.style.color = color;
    modalBody.style.color = 'var(--text)';
    loader.style.color = color;
    
    const todayStr = specificDate || getTodayISOString();
    modalTitle.innerHTML = `🚀 Log training: ${dayConfig.name || dayConfig.type.toUpperCase()}`;

    let exercises = [];
    if (dayConfig.customExercises) {
        exercises = dayConfig.customExercises;
    } else {
        const dbData = PROTOCOL_DB[dayConfig.dbIndex];
        if (dbData) {
            exercises = [...(dbData.ex1 || []), ...(dbData.ex2 || [])];
        }
    }

    setTimeout(() => {
        loader.style.display = 'none';
        
        let htmlContent = `
            <div class="logger-header">
                <div>
                    <label class="logger-label" style="display: block; margin-bottom: 4px; font-weight: 700;">WORKOUT DATE:</label>
                    <input type="date" id="logWorkoutDate" value="${todayStr}" class="logger-input" style="width: 160px; text-align: left; font-size: 0.9rem; padding: 6px 10px; height:auto;">
                </div>
                <div style="font-family: 'Oswald', sans-serif; font-size: 1.1rem; color: ${color}; text-transform: uppercase; letter-spacing: 0.5px;">
                    ${exercises.length} Exercises Scheduled
                </div>
            </div>
            
            <div class="logger-exercises-container">
        `;
        
        if (exercises.length === 0) {
            htmlContent += `<div class="empty-state">No exercises configured. Go to Weekly Plan to customize exercises first!</div>`;
        } else {
            exercises.forEach((ex, exIdx) => {
                htmlContent += `
                    <div class="logger-exercise-card">
                        <div class="logger-exercise-title" style="color: var(--text);">${ex.name} <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-dim);">— ${ex.desc || ''}</span></div>
                        <div class="logger-sets-container" id="setsContainer_${exIdx}">
                            <div class="logger-set-row" data-set-num="1">
                                <span class="logger-set-num">SET 1</span>
                                <div class="logger-input-group">
                                    <input type="number" placeholder="Weight" class="logger-input weight-input" id="weight_${exIdx}_1" value="0">
                                    <span class="logger-label">kg</span>
                                </div>
                                <div class="logger-input-group">
                                    <input type="number" placeholder="Reps" class="logger-input reps-input" id="reps_${exIdx}_1" value="0">
                                    <span class="logger-label">reps</span>
                                </div>
                            </div>
                            <div class="logger-set-row" data-set-num="2">
                                <span class="logger-set-num">SET 2</span>
                                <div class="logger-input-group">
                                    <input type="number" placeholder="Weight" class="logger-input weight-input" id="weight_${exIdx}_2" value="0">
                                    <span class="logger-label">kg</span>
                                </div>
                                <div class="logger-input-group">
                                    <input type="number" placeholder="Reps" class="logger-input reps-input" id="reps_${exIdx}_2" value="0">
                                    <span class="logger-label">reps</span>
                                </div>
                            </div>
                            <div class="logger-set-row" data-set-num="3">
                                <span class="logger-set-num">SET 3</span>
                                <div class="logger-input-group">
                                    <input type="number" placeholder="Weight" class="logger-input weight-input" id="weight_${exIdx}_3" value="0">
                                    <span class="logger-label">kg</span>
                                </div>
                                <div class="logger-input-group">
                                    <input type="number" placeholder="Reps" class="logger-input reps-input" id="reps_${exIdx}_3" value="0">
                                    <span class="logger-label">reps</span>
                                </div>
                            </div>
                        </div>
                        <div style="margin-top: 10px; display: flex; gap: 10px;">
                            <button type="button" class="btn-add-set" onclick="addSetRow(${exIdx})">+ Add Set</button>
                            <button type="button" class="btn-del-set" onclick="removeSetRow(${exIdx})">- Remove Set</button>
                            <button type="button" class="btn-add-set" style="border-color:var(--legs); color:var(--legs);" onclick="toggleRestTimerWidget()">⏱️ Start Rest Timer</button>
                        </div>
                    </div>
                `;
            });
        }
        
        htmlContent += `
            </div>
            
            <div>
                <label class="logger-label" style="display: block; margin-bottom: 6px; font-weight: 700;">SESSION REFLECTIONS & PERFORMANCE NOTES:</label>
                <textarea id="logWorkoutNotes" class="logger-textarea" placeholder="How did this workout feel? Log your energy, focus, strength progression, and active sets notes..."></textarea>
            </div>
            
            <div style="margin-top: 30px; display: flex; gap: 15px; justify-content: flex-end;">
                <button class="rest-btn" onclick="closeModal()">Cancel</button>
                <button class="load-btn" style="background: ${color}; border-color: ${color}; color: #fff; padding: 12px 25px; border-radius: 8px; font-family: 'Oswald', sans-serif; font-size: 1.1rem; cursor: pointer; text-transform: uppercase;" onclick="saveWorkoutSession(${dayIndex}, ${exercises.length})">💾 Save Workout</button>
            </div>
        `;
        
        modalBody.innerHTML = htmlContent;
    }, 200);
}

function addSetRow(exIdx) {
    const container = document.getElementById(`setsContainer_${exIdx}`);
    if (!container) return;
    const rows = container.getElementsByClassName('logger-set-row');
    const newSetNum = rows.length + 1;
    
    const row = document.createElement('div');
    row.className = 'logger-set-row';
    row.setAttribute('data-set-num', newSetNum);
    row.innerHTML = `
        <span class="logger-set-num">SET ${newSetNum}</span>
        <div class="logger-input-group">
            <input type="number" placeholder="Weight" class="logger-input weight-input" id="weight_${exIdx}_${newSetNum}" value="0">
            <span class="logger-label">kg</span>
        </div>
        <div class="logger-input-group">
            <input type="number" placeholder="Reps" class="logger-input reps-input" id="reps_${exIdx}_${newSetNum}" value="0">
            <span class="logger-label">reps</span>
        </div>
    `;
    container.appendChild(row);
}

function removeSetRow(exIdx) {
    const container = document.getElementById(`setsContainer_${exIdx}`);
    if (!container) return;
    const rows = container.getElementsByClassName('logger-set-row');
    if (rows.length > 1) {
        container.removeChild(rows[rows.length - 1]);
    }
}

function saveWorkoutSession(dayIndex, exercisesLength) {
    const dayConfig = GymStore.schedule[dayIndex];
    const logDate = document.getElementById('logWorkoutDate').value;
    const notes = document.getElementById('logWorkoutNotes').value;
    
    if (!logDate) {
        alert("Please select a workout date!");
        return;
    }
    
    let exercises = [];
    if (dayConfig.customExercises) {
        exercises = dayConfig.customExercises;
    } else {
        const dbData = PROTOCOL_DB[dayConfig.dbIndex];
        if (dbData) {
            exercises = [...(dbData.ex1 || []), ...(dbData.ex2 || [])];
        }
    }
    
    const loggedExercises = [];
    
    exercises.forEach((ex, exIdx) => {
        const container = document.getElementById(`setsContainer_${exIdx}`);
        if (!container) return;
        const rows = container.getElementsByClassName('logger-set-row');
        const loggedSets = [];
        
        for (let i = 0; i < rows.length; i++) {
            const setNum = rows[i].getAttribute('data-set-num');
            const wInput = document.getElementById(`weight_${exIdx}_${setNum}`);
            const rInput = document.getElementById(`reps_${exIdx}_${setNum}`);
            
            const weightVal = wInput ? (parseFloat(wInput.value) || 0) : 0;
            const repsVal = rInput ? (parseInt(rInput.value) || 0) : 0;
            loggedSets.push({ set: i + 1, weight: weightVal, reps: repsVal });
        }
        
        loggedExercises.push({
            name: ex.name,
            desc: ex.desc,
            sets: loggedSets
        });
    });
    
    const historyItem = {
        id: Date.now(),
        date: logDate,
        type: dayConfig.type,
        name: dayConfig.name || dayConfig.type.toUpperCase(),
        exercises: loggedExercises,
        notes: notes
    };
    
    GymStore.history.unshift(historyItem);
    saveStore();
    calculateStreakValue();
    closeModal();
    
    ConfettiEngine.burst(window.innerWidth / 2, window.innerHeight / 2, 100);
    playTripleChime();
    showToast("Workout saved perfectly! 🔥", "🎉");
    
    // Refresh currently open tab
    renderGrid();
    renderCalendar();
    renderHistory();
    renderAnalyticsDashboard();
}

// --- CALENDAR VIEW LOGIC ---
function changeMonth(dir) {
    currentMonth += dir;
    if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
    } else if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
    }
    renderCalendar();
}

function renderCalendar() {
    const title = document.getElementById('calendarTitle');
    const grid = document.getElementById('calendarGridCells');
    
    if (!title || !grid) return;
    
    const monthNames = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
    title.innerText = `${monthNames[currentMonth]} ${currentYear}`;
    
    grid.innerHTML = '';
    
    let firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
    firstDayIndex = firstDayIndex === 0 ? 6 : firstDayIndex - 1;
    
    const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();
    const prevTotalDays = new Date(currentYear, currentMonth, 0).getDate();
    
    const today = new Date();
    const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
    
    // 1. Trailing days of previous month
    for (let i = firstDayIndex - 1; i >= 0; i--) {
        const d = prevTotalDays - i;
        const cell = document.createElement('div');
        cell.className = 'calendar-cell other-month';
        cell.innerHTML = `<span class="cell-date">${d}</span>`;
        grid.appendChild(cell);
    }
    
    // 2. Days of the current month
    for (let d = 1; d <= totalDays; d++) {
        const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        const dayOfWeek = (firstDayIndex + d - 1) % 7;
        const sched = GymStore.schedule[dayOfWeek];
        
        const completedLogs = GymStore.history.filter(h => h.date === dateStr);
        const hasCompleted = completedLogs.length > 0;
        const isToday = dateStr === todayStr;
        
        const cell = document.createElement('div');
        cell.className = `calendar-cell ${isToday ? 'today' : ''}`;
        
        let workoutBadge = '';
        if (sched) {
            let badgeType = sched.type;
            if (badgeType === 'custom') {
                if (sched.name.toLowerCase().includes('push')) badgeType = 'push';
                else if (sched.name.toLowerCase().includes('pull')) badgeType = 'pull';
                else if (sched.name.toLowerCase().includes('legs')) badgeType = 'legs';
            }
            
            const classMap = { push: 'workout-push', pull: 'workout-pull', legs: 'workout-legs', rest: 'workout-rest', custom: 'workout-custom' };
            const badgeClass = classMap[badgeType] || 'workout-rest';
            
            workoutBadge = `<div class="cell-workout ${badgeClass}">${sched.rest ? 'Rest' : (sched.name || sched.type)}</div>`;
        }
        
        cell.innerHTML = `
            <span class="cell-date">${d}</span>
            ${workoutBadge}
            ${hasCompleted ? `<div class="cell-completed-badge" title="Completed ${completedLogs.length} Workout(s)">✓</div>` : ''}
        `;
        
        cell.onclick = () => openCalendarDayDetails(d, dateStr, dayOfWeek, sched, completedLogs);
        grid.appendChild(cell);
    }
    
    // 3. Leading days of the next month
    const totalCells = Math.ceil((firstDayIndex + totalDays) / 7) * 7;
    const postCells = totalCells - (firstDayIndex + totalDays);
    for (let d = 1; d <= postCells; d++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-cell other-month';
        cell.innerHTML = `<span class="cell-date">${d}</span>`;
        grid.appendChild(cell);
    }
}

function openCalendarDayDetails(dayNum, dateStr, dayOfWeek, sched, completedLogs) {
    modal.classList.add('active');
    modalBody.innerHTML = '';
    loader.style.display = 'block';
    
    let displayType = sched.type;
    if (displayType === 'custom') {
        if (sched.name.toLowerCase().includes('push')) displayType = 'push';
        else if (sched.name.toLowerCase().includes('pull')) displayType = 'pull';
        else if (sched.name.toLowerCase().includes('legs')) displayType = 'legs';
    }
    
    const colors = { push: 'var(--crimson)', pull: 'var(--pull)', legs: 'var(--legs)', rest: 'var(--text)', custom: '#9F7AEA' };
    const color = colors[displayType] || 'var(--text)';
    
    modalTitle.style.color = color;
    modalBody.style.color = 'var(--text)';
    loader.style.color = color;
    
    const weekdayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    modalTitle.innerHTML = `📅 ${weekdayNames[dayOfWeek]}, ${dateStr}`;
    
    const calendarNote = GymStore.calendarNotes[dateStr] || '';
    
    setTimeout(() => {
        loader.style.display = 'none';
        
        let logsHtml = '';
        if (completedLogs.length > 0) {
            logsHtml += `
                <h3 style="color: var(--legs); border-color: var(--legs); font-size: 1.2rem; margin-top: 20px;">COMPLETED SESSIONS:</h3>
                <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 10px;">
            `;
            completedLogs.forEach(log => {
                logsHtml += `
                    <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px 15px;">
                        <strong style="color: var(--text); font-size: 0.95rem;">${log.name}</strong>
                        <div style="font-size: 0.8rem; color: var(--text-dim); margin-top: 4px;">Completed at: ${new Date(log.id).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
                        ${log.notes ? `<div style="font-size: 0.85rem; background: var(--card-bg); border-left: 2px solid var(--legs); padding: 4px 10px; margin-top: 8px;">${log.notes}</div>` : ''}
                    </div>
                `;
            });
            logsHtml += `</div>`;
        } else {
            logsHtml = `
                <div style="margin-top: 20px;" class="empty-state">No sessions logged for this day yet.</div>
            `;
        }
        
        modalBody.innerHTML = `
            <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                <h4 style="font-family: 'Oswald', sans-serif; font-size: 1.1rem; color: var(--text-dim); text-transform: uppercase;">Scheduled Workout:</h4>
                <h2 style="font-family: 'Oswald', sans-serif; font-size: 1.6rem; color: ${color}; text-transform: uppercase; margin: 4px 0 10px 0;">
                    ${sched.rest ? 'Rest & Recovery' : (sched.name || sched.type.toUpperCase())}
                </h2>
                ${sched.rest ? `
                    <p style="font-size: 0.9rem; color: var(--text-dim);">No structured workout scheduled. Good day to focus on recovery flow, mobility, and deep downregulating breathing.</p>
                ` : `
                    <p style="font-size: 0.9rem; color: var(--text); font-weight: 500; text-transform: uppercase; margin-bottom: 4px;">Muscle Targets:</p>
                    <p style="font-size: 0.85rem; color: var(--text-dim); margin-bottom: 12px;">${sched.m1} (${sched.sub1}) ${sched.m2 ? ` &bull; ${sched.m2} (${sched.sub2})` : ''}</p>
                `}
            </div>
            
            <div style="margin-bottom: 20px;">
                <label class="logger-label" style="display: block; margin-bottom: 6px; font-weight: 700;">DATE-SPECIFIC GOALS OR PLANNING NOTES:</label>
                <textarea id="calDayNoteInput" class="logger-textarea" placeholder="Write any specific targets for this date (e.g. 'Pushing heavy incline bench today!', 'Focus on explosive contractions')..." onchange="saveCalendarNote('${dateStr}')">${calendarNote}</textarea>
            </div>
            
            ${logsHtml}
            
            <div style="margin-top: 30px; display: flex; gap: 15px; justify-content: flex-end;">
                <button class="rest-btn" onclick="closeModal()">Close</button>
                ${sched.rest ? '' : `
                    <button class="load-btn" style="background: ${color}; border-color: ${color}; color: #fff; padding: 12px 25px; border-radius: 8px; font-family: 'Oswald', sans-serif; font-size: 1.1rem; cursor: pointer; text-transform: uppercase;" onclick="closeModal(); startWorkoutSession(${dayOfWeek}, '${dateStr}')">🚀 Start Workout</button>
                `}
            </div>
        `;
    }, 200);
}

function saveCalendarNote(dateStr) {
    const val = document.getElementById('calDayNoteInput').value;
    if (val.trim()) {
        GymStore.calendarNotes[dateStr] = val;
    } else {
        delete GymStore.calendarNotes[dateStr];
    }
    saveStore();
}

// --- HISTORY TAB LOGIC ---
function renderHistory() {
    const container = document.getElementById('historyContainer');
    if (!container) return;
    
    if (GymStore.history.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                NO WORKOUT HISTORY FOUND<br>
                <span style="font-size: 0.85rem; font-weight: normal; text-transform: uppercase; color: var(--text-dim); margin-top: 10px; display: block;">
                    Complete and save your active sessions to build your peak training timeline.
                </span>
            </div>
        `;
        return;
    }
    
    let html = '';
    
    GymStore.history.forEach((log) => {
        let displayType = log.type;
        if (displayType === 'custom') {
            if (log.name.toLowerCase().includes('push')) displayType = 'push';
            else if (log.name.toLowerCase().includes('pull')) displayType = 'pull';
            else if (log.name.toLowerCase().includes('legs')) displayType = 'legs';
        }
        
        const colors = { push: 'var(--crimson)', pull: 'var(--pull)', legs: 'var(--legs)', rest: 'var(--text)', custom: '#9F7AEA' };
        const color = colors[displayType] || 'var(--text)';
        
        let exercisesHtml = '';
        
        if (log.type === 'skipped') {
            exercisesHtml = `<p style="font-size:0.85rem; color:var(--text-dim);">${log.notes || 'Skipped scheduled training day.'}</p>`;
        } else {
            log.exercises.forEach(ex => {
                let setsHtml = '';
                ex.sets.forEach(set => {
                    setsHtml += `
                        <span class="history-set-pill">SET ${set.set}: <strong>${set.weight}kg</strong> &times; <strong>${set.reps}</strong></span>
                    `;
                });
                exercisesHtml += `
                    <div class="history-exercise-row">
                        <div class="history-exercise-name" style="color: var(--text);">${ex.name}</div>
                        <div class="history-set-pills">${setsHtml}</div>
                    </div>
                `;
            });
        }
        
        html += `
            <div class="history-card" style="border-left: 6px solid ${color};">
                <div class="history-card-header">
                    <div>
                        <div class="history-card-date">${log.date}</div>
                        <div class="history-card-title" style="color: ${color};">${log.name}</div>
                    </div>
                    <button class="btn-delete-log" onclick="deleteHistoryItem(${log.id})">🗑 Delete Log</button>
                </div>
                
                <div class="history-exercises-list">
                    ${exercisesHtml}
                </div>
                
                ${log.notes && log.type !== 'skipped' ? `
                    <div class="history-note-box" style="border-color: ${color};">
                        <strong>Session Reflection:</strong><br>
                        ${log.notes}
                    </div>
                ` : ''}
            </div>
        `;
    });
    
    container.innerHTML = html;
}

function deleteHistoryItem(id) {
    if (confirm("Are you sure you want to delete this workout log?")) {
        GymStore.history = GymStore.history.filter(h => h.id !== id);
        saveStore();
        calculateStreakValue();
        renderGrid();
        renderCalendar();
        renderHistory();
        renderAnalyticsDashboard();
    }
}

// --- CUSTOMIZE DAYS SCHEDULE LOGIC ---
function openCustomizeModal(dayIndex) {
    modal.classList.add('active');
    modalBody.innerHTML = '';
    loader.style.display = 'block';
    
    modalTitle.style.color = 'var(--text)';
    modalBody.style.color = 'var(--text)';
    loader.style.color = 'var(--text)';
    
    modalTitle.innerHTML = `⚙️ CUSTOMIZE: ${DAYS[dayIndex]}`;
    
    const currentDayConfig = GymStore.schedule[dayIndex];
    
    setTimeout(() => {
        loader.style.display = 'none';
        
        let html = `
            <div style="margin-bottom: 20px;">
                <label class="logger-label" style="display: block; margin-bottom: 6px; font-weight: 700;">SELECT WORKOUT TEMPLATE:</label>
                <select id="custTemplateSelect" class="logger-input" style="width: 100%; text-align: left; font-size: 0.9rem; padding: 10px; height: auto;" onchange="onCustTemplateChange(${dayIndex})">
                    <option value="push1" ${currentDayConfig.type === 'push' && currentDayConfig.dbIndex === 0 ? 'selected' : ''}>Push 1 (Chest, Triceps)</option>
                    <option value="pull1" ${currentDayConfig.type === 'pull' && currentDayConfig.dbIndex === 1 ? 'selected' : ''}>Pull 1 (Back, Biceps)</option>
                    <option value="legs1" ${currentDayConfig.type === 'legs' && currentDayConfig.dbIndex === 2 ? 'selected' : ''}>Legs 1 & Shoulders 1</option>
                    <option value="push2" ${currentDayConfig.type === 'push' && currentDayConfig.dbIndex === 3 ? 'selected' : ''}>Push 2 (Chest, Triceps)</option>
                    <option value="pull2" ${currentDayConfig.type === 'pull' && currentDayConfig.dbIndex === 4 ? 'selected' : ''}>Pull 2 (Back, Biceps)</option>
                    <option value="legs2" ${currentDayConfig.type === 'legs' && currentDayConfig.dbIndex === 5 ? 'selected' : ''}>Legs 2 & Shoulders 2</option>
                    <option value="rest" ${currentDayConfig.rest ? 'selected' : ''}>Rest & Recovery Day</option>
                    <option value="custom" ${currentDayConfig.type === 'custom' ? 'selected' : ''}>Custom Workout...</option>
                </select>
            </div>
            
            <div id="customWorkoutFields" style="display: ${currentDayConfig.type === 'custom' ? 'block' : 'none'}; border-top: 1px solid var(--border); padding-top: 20px; margin-top: 20px;">
                <div style="margin-bottom: 15px;">
                    <label class="logger-label" style="display: block; margin-bottom: 4px; font-weight: 700;">Workout Name:</label>
                    <input type="text" id="custWorkoutName" class="logger-input" style="width: 100%; text-align: left; padding: 8px 12px;" value="${currentDayConfig.type === 'custom' ? currentDayConfig.name : ''}" placeholder="e.g. Upper Body Power">
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                    <div>
                        <label class="logger-label" style="display: block; margin-bottom: 4px; font-weight: 700;">Muscle Group 1:</label>
                        <input type="text" id="custM1" class="logger-input" style="width: 100%; text-align: left; padding: 8px 12px;" value="${currentDayConfig.type === 'custom' ? currentDayConfig.m1 : ''}" placeholder="e.g. CHEST">
                    </div>
                    <div>
                        <label class="logger-label" style="display: block; margin-bottom: 4px; font-weight: 700;">M1 Subtitle / Target:</label>
                        <input type="text" id="custSub1" class="logger-input" style="width: 100%; text-align: left; padding: 8px 12px;" value="${currentDayConfig.type === 'custom' ? currentDayConfig.sub1 : ''}" placeholder="e.g. PRIMARY: PECTORALS">
                    </div>
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                    <div>
                        <label class="logger-label" style="display: block; margin-bottom: 4px; font-weight: 700;">Muscle Group 2 (Optional):</label>
                        <input type="text" id="custM2" class="logger-input" style="width: 100%; text-align: left; padding: 8px 12px;" value="${currentDayConfig.type === 'custom' ? currentDayConfig.m2 : ''}" placeholder="e.g. TRICEPS">
                    </div>
                    <div>
                        <label class="logger-label" style="display: block; margin-bottom: 4px; font-weight: 700;">M2 Subtitle / Target:</label>
                        <input type="text" id="custSub2" class="logger-input" style="width: 100%; text-align: left; padding: 8px 12px;" value="${currentDayConfig.type === 'custom' ? currentDayConfig.sub2 : ''}" placeholder="e.g. SECONDARY: PUSH">
                    </div>
                </div>
                
                <div style="border-top: 1px solid var(--border); padding-top: 15px; margin-bottom: 15px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h4 style="font-family: 'Oswald', sans-serif; font-size: 1.1rem; color: var(--text);">Exercises List</h4>
                        <button type="button" class="btn-action-sm" onclick="addCustExerciseRow()">+ Add Exercise</button>
                    </div>
                    <div id="custExercisesContainer">
                        <!-- Custom rows -->
                    </div>
                </div>
            </div>
            
            <div style="margin-top: 30px; display: flex; gap: 15px; justify-content: flex-end;">
                <button class="rest-btn" onclick="closeModal()">Cancel</button>
                <button class="load-btn" style="background: var(--text); border-color: var(--text); color: var(--card-bg); padding: 12px 25px; border-radius: 8px; font-family: 'Oswald', sans-serif; font-size: 1.1rem; cursor: pointer; text-transform: uppercase;" onclick="saveCustomizeDay(${dayIndex})">💾 Save Settings</button>
            </div>
        `;
        
        modalBody.innerHTML = html;
        
        if (currentDayConfig.type === 'custom') {
            const exercises = currentDayConfig.customExercises || [];
            exercises.forEach(ex => addCustExerciseRow(ex.name, ex.desc, ex.time, ex.start));
        }
    }, 200);
}

function onCustTemplateChange(dayIndex) {
    const select = document.getElementById('custTemplateSelect');
    const fields = document.getElementById('customWorkoutFields');
    if (!select || !fields) return;
    
    if (select.value === 'custom') {
        fields.style.display = 'block';
        const current = GymStore.schedule[dayIndex];
        if (current.type !== 'custom') {
            document.getElementById('custWorkoutName').value = current.rest ? 'Custom Workout' : current.name;
            document.getElementById('custM1').value = current.rest ? '' : current.m1;
            document.getElementById('custSub1').value = current.rest ? '' : current.sub1;
            document.getElementById('custM2').value = current.rest ? '' : current.m2;
            document.getElementById('custSub2').value = current.rest ? '' : current.sub2;
            
            const container = document.getElementById('custExercisesContainer');
            container.innerHTML = '';
            
            let defaultEx = [];
            if (!current.rest && current.dbIndex !== -1) {
                const db = PROTOCOL_DB[current.dbIndex];
                if (db) {
                    defaultEx = [...(db.ex1 || []), ...(db.ex2 || [])];
                }
            }
            defaultEx.forEach(ex => addCustExerciseRow(ex.name, ex.desc, ex.time, ex.start));
        }
    } else {
        fields.style.display = 'none';
    }
}

function addCustExerciseRow(name = '', desc = '', time = '3:00', start = 60) {
    const container = document.getElementById('custExercisesContainer');
    if (!container) return;
    const row = document.createElement('div');
    row.className = 'customize-item-row';
    row.innerHTML = `
        <div style="flex-grow: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <input type="text" class="logger-input cust-ex-name" style="width:100%; text-align:left; padding:6px 10px;" value="${name}" placeholder="Exercise Name">
            <input type="text" class="logger-input cust-ex-desc" style="width:100%; text-align:left; padding:6px 10px;" value="${desc}" placeholder="Description / Tips">
        </div>
        <div style="width: 100px; display: flex; gap: 5px;">
            <input type="text" class="logger-input cust-ex-time" style="width:100%; padding:6px;" value="${time}" placeholder="Time">
            <input type="hidden" class="cust-ex-start" value="${start}">
        </div>
        <button type="button" class="btn-del-set" style="padding: 6px 10px;" onclick="this.parentNode.parentNode.removeChild(this.parentNode)">🗑</button>
    `;
    container.appendChild(row);
}

function saveCustomizeDay(dayIndex) {
    const select = document.getElementById('custTemplateSelect');
    if (!select) return;
    const val = select.value;
    
    if (val === 'rest') {
        GymStore.schedule[dayIndex] = {
            type: 'rest',
            name: 'Rest Day',
            dbIndex: -1,
            m1: 'REST',
            sub1: 'RECOVERY DAY',
            m2: '',
            sub2: '',
            rest: true,
            customExercises: null
        };
    } else if (val === 'custom') {
        const nameVal = document.getElementById('custWorkoutName').value || 'Custom Workout';
        const m1Val = document.getElementById('custM1').value || 'CUSTOM';
        const sub1Val = document.getElementById('custSub1').value || 'PRIMARY WORK';
        const m2Val = document.getElementById('custM2').value || '';
        const sub2Val = document.getElementById('custSub2').value || '';
        
        const container = document.getElementById('custExercisesContainer');
        const rows = container.getElementsByClassName('customize-item-row');
        const customExercises = [];
        
        for (let i = 0; i < rows.length; i++) {
            const exName = rows[i].querySelector('.cust-ex-name').value;
            const exDesc = rows[i].querySelector('.cust-ex-desc').value;
            const exTime = rows[i].querySelector('.cust-ex-time').value;
            const exStart = parseInt(rows[i].querySelector('.cust-ex-start').value) || 0;
            
            if (exName.trim()) {
                customExercises.push({
                    name: exName,
                    desc: exDesc,
                    time: exTime,
                    start: exStart
                });
            }
        }
        
        GymStore.schedule[dayIndex] = {
            type: 'custom',
            name: nameVal,
            dbIndex: -1,
            m1: m1Val,
            sub1: sub1Val,
            m2: m2Val,
            sub2: sub2Val,
            rest: false,
            customExercises: customExercises
        };
    } else {
        const map = {
            push1: { type: 'push', dbIndex: 0 },
            pull1: { type: 'pull', dbIndex: 1 },
            legs1: { type: 'legs', dbIndex: 2 },
            push2: { type: 'push', dbIndex: 3 },
            pull2: { type: 'pull', dbIndex: 4 },
            legs2: { type: 'legs', dbIndex: 5 }
        };
        const template = map[val];
        const w = WORKOUTS[template.dbIndex];
        
        let displayName = '';
        if (w.type === 'push') displayName = w.m1 === 'CHEST' && w.sub1.includes('Upper') ? 'Push 1' : 'Push 2';
        else if (w.type === 'pull') displayName = w.m1 === 'BACK' && w.sub1.includes('Width') ? 'Pull 1' : 'Pull 2';
        else displayName = w.m1 === 'LEGS' && w.sub1.includes('Posterior') ? 'Legs 1 & Shoulders 1' : 'Legs 2 & Shoulders 2';

        GymStore.schedule[dayIndex] = {
            type: w.type,
            name: displayName,
            dbIndex: template.dbIndex,
            m1: w.m1,
            sub1: w.sub1,
            m2: w.m2,
            sub2: w.sub2,
            rest: false,
            customExercises: null
        };
    }
    
    const restIdx = GymStore.schedule.findIndex(d => d.rest);
    if (restIdx !== -1) {
        currentRestDay = restIdx;
    }
    
    saveStore();
    closeModal();
    
    renderPicker();
    renderGrid();
    renderCalendar();
    renderHistory();
    renderAnalyticsDashboard();
}

// --- TAB SWAPPER ---
function switchTab(tabId) {
    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.nav-tab').forEach(el => el.classList.remove('active'));
    
    const pContainer = document.getElementById('restPickerContainer');
    
    if (tabId === 'week') {
        document.getElementById('weekView').style.display = 'block';
        document.getElementById('btnTabWeek').classList.add('active');
        if (pContainer) pContainer.style.display = 'flex';
        renderGrid();
    } else if (tabId === 'calendar') {
        document.getElementById('calendarView').style.display = 'block';
        document.getElementById('btnTabCalendar').classList.add('active');
        if (pContainer) pContainer.style.display = 'none';
        renderCalendar();
    } else if (tabId === 'history') {
        document.getElementById('historyView').style.display = 'block';
        document.getElementById('btnTabHistory').classList.add('active');
        if (pContainer) pContainer.style.display = 'none';
        renderHistory();
    } else if (tabId === 'analytics') {
        document.getElementById('analyticsView').style.display = 'block';
        document.getElementById('btnTabAnalytics').classList.add('active');
        if (pContainer) pContainer.style.display = 'none';
        renderAnalyticsDashboard();
    }
}

// --- DYNAMIC GRAPHING & ANALYTICS VIEW ---
function renderAnalyticsDashboard() {
    updateHeaderProgressBar();
    
    // Circular consistency indicator
    const plannedCount = GymStore.schedule.filter(d => !d.rest).length;
    const today = new Date();
    const distanceToMonday = today.getDay() === 0 ? -6 : 1 - today.getDay();
    const startOfWeek = new Date(today);
    startOfWeek.setDate(today.getDate() + distanceToMonday);
    startOfWeek.setHours(0,0,0,0);
    
    const loggedThisWeek = GymStore.history.filter(log => {
        const d = new Date(log.date);
        return d >= startOfWeek && log.type !== 'skipped';
    }).length;
    
    const pct = plannedCount > 0 ? Math.min(100, Math.round((loggedThisWeek / plannedCount) * 100)) : 0;
    
    // Animate SVG Ring
    const ring = document.getElementById('analyticsRingProgress');
    if (ring) {
        const circumference = 376.99; // 2 * pi * r (r=60)
        const offset = circumference - (pct / 100) * circumference;
        ring.style.strokeDashoffset = offset;
    }
    
    const pctLabel = document.getElementById('analyticsPctLabel');
    if (pctLabel) pctLabel.innerText = `${pct}%`;
    
    const detailLabel = document.getElementById('analyticsDetailLabel');
    if (detailLabel) detailLabel.innerText = `${loggedThisWeek} out of ${plannedCount} active days logged this week`;

    // 2. Rolling Volume Chart JS calculation (Weight * Reps)
    const rollingWeeksLoad = [0, 0, 0, 0]; // 3wks ago, 2wks ago, last wk, this wk
    
    GymStore.history.forEach(log => {
        if (log.type === 'skipped') return;
        
        const logDate = new Date(log.date);
        const timeDiff = Math.abs(today - logDate);
        const diffDays = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));
        
        let weekBucket = -1;
        if (diffDays <= 7) weekBucket = 3; // this week
        else if (diffDays <= 14) weekBucket = 2; // last week
        else if (diffDays <= 21) weekBucket = 1; // 2 weeks ago
        else if (diffDays <= 28) weekBucket = 0; // 3 weeks ago
        
        if (weekBucket !== -1) {
            let sessionVol = 0;
            log.exercises.forEach(ex => {
                ex.sets.forEach(set => {
                    sessionVol += set.weight * set.reps;
                });
            });
            rollingWeeksLoad[weekBucket] += sessionVol;
        }
    });
    
    // Draw SVG Bars
    const chart = document.getElementById('volumeChartContainer');
    if (chart) {
        const maxLoad = Math.max(...rollingWeeksLoad, 1000); // prevent division by zero
        
        chart.innerHTML = rollingWeeksLoad.map((load, idx) => {
            const pctHeight = Math.min(100, Math.round((load / maxLoad) * 100));
            return `
                <div style="height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; width: 45px;">
                    <div style="font-size: 0.65rem; font-weight: bold; margin-bottom: 4px; color: var(--text);">${load}kg</div>
                    <div style="height: ${pctHeight}%; width: 100%; background: var(--pull); border-radius: 6px 6px 0 0; box-shadow: 0 0 10px var(--pull-glow); transition: height 0.5s ease;" class="svg-bar" title="Total Load: ${load} kg"></div>
                </div>
            `;
        }).join('');
    }

    // 3. Muscle Split Distribution Graph (Horizontal flex bars)
    const muscleVolume = { CHEST: 0, BACK: 0, LEGS: 0, SHOULDERS: 0, ARMS: 0, OTHER: 0 };
    GymStore.history.forEach(log => {
        if (log.type === 'skipped') return;
        log.exercises.forEach(ex => {
            let vol = 0;
            ex.sets.forEach(s => vol += s.weight * s.reps);
            
            const nameUpper = ex.name.toUpperCase();
            if (nameUpper.includes('BENCH') || nameUpper.includes('FLY') || nameUpper.includes('CHEST') || nameUpper.includes('DIP')) {
                muscleVolume.CHEST += vol;
            } else if (nameUpper.includes('ROW') || nameUpper.includes('PULL') || nameUpper.includes('LAT') || nameUpper.includes('SCAP')) {
                muscleVolume.BACK += vol;
            } else if (nameUpper.includes('SQUAT') || nameUpper.includes('LUNGE') || nameUpper.includes('LEG') || nameUpper.includes('DEADLIFT') || nameUpper.includes('THRUST') || nameUpper.includes('HAMSTRING')) {
                muscleVolume.LEGS += vol;
            } else if (nameUpper.includes('PRESS') || nameUpper.includes('RAISE') || nameUpper.includes('DELT')) {
                muscleVolume.SHOULDERS += vol;
            } else if (nameUpper.includes('CURL') || nameUpper.includes('TRICEP') || nameUpper.includes('EXTENSION') || nameUpper.includes('KICKBACK')) {
                muscleVolume.ARMS += vol;
            } else {
                muscleVolume.OTHER += vol;
            }
        });
    });
    
    const totalVolume = Object.values(muscleVolume).reduce((a,b) => a + b, 0) || 1;
    const colors = { CHEST: 'var(--crimson)', BACK: 'var(--pull)', LEGS: 'var(--legs)', SHOULDERS: '#9F7AEA', ARMS: '#ED64A6', OTHER: '#A0AEC0' };
    
    const splitContainer = document.getElementById('muscleDistributionChart');
    if (splitContainer) {
        splitContainer.innerHTML = Object.entries(muscleVolume).map(([m, vol]) => {
            const pctWidth = Math.round((vol / totalVolume) * 100);
            return `
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 700; margin-bottom: 2px;">
                        <span>${m}</span>
                        <span>${vol} kg (${pctWidth}%)</span>
                    </div>
                    <div style="background: var(--border); height: 8px; border-radius: 4px; overflow: hidden;">
                        <div style="width: ${pctWidth}%; background: ${colors[m] || 'var(--pull)'}; height: 100%; border-radius: 4px; transition: width 0.5s ease;"></div>
                    </div>
                </div>
            `;
        }).join('');
    }
    
    // AI Physiology Coach text advisor based on volume trends & streaks
    const coachText = document.getElementById('aiCoachText');
    if (coachText) {
        if (GymStore.history.length === 0) {
            coachText.innerText = "Welcome to the training grid! To trigger localized coach progression models, log your first session above. We will analyze your volumetric progression coefficients.";
        } else {
            // Check streak fatigue risk
            if (GymStore.streak >= 4) {
                coachText.innerHTML = `⚠️ <strong>FATIGUE DETECTED:</strong> You are on a ${GymStore.streak}-day consistent training loading pattern. Central Nervous System fatigue limits may be approaching. Substitution of tomorrow's session with deep downregulating Recovery box breathing is highly advised.`;
            } else if (muscleVolume.LEGS < (muscleVolume.CHEST + muscleVolume.BACK) * 0.4) {
                coachText.innerHTML = `🚨 <strong>ASYMMETRICAL VOLUME ALERT:</strong> Leg target volume (${muscleVolume.LEGS} kg) is trailing upper posterior structures. Adding 1 compound squat or posterior lift set to your legs plan will improve total body athletic leverage ratios.`;
            } else {
                coachText.innerHTML = `✅ <strong>STABILIZED PROTOCOL:</strong> Training coefficient targets look exceptional. Total load Volume is pacing upwards. Keep pushing set limits with 90-120 seconds rest intervals to maintain progressive overload threshold stimulation.`;
            }
        }
    }
}

// --- VIDEO LOADER ---
const modal = document.getElementById('protocolModal');
const modalBody = document.getElementById('modalBody');
const modalTitle = document.getElementById('modalTitle');
const loader = document.getElementById('loader');
const modalContent = document.getElementById('modalContent');

function closeModal() {
    if (modal) modal.classList.remove('active');
    const videoWrapper = document.getElementById('videoWrapper');
    if (videoWrapper) videoWrapper.style.display = 'none';
    const videoContainer = document.getElementById('videoContainer');
    if (videoContainer) videoContainer.innerHTML = '';
}

function openExerciseList(dayIndex, groupNum, type) {
    modal.classList.add('active');
    modalBody.innerHTML = '';
    loader.style.display = 'block';
    
    const colors = { push: 'var(--crimson)', pull: 'var(--pull)', legs: 'var(--legs)', rest: 'var(--text)', custom: '#9F7AEA' };
    const color = colors[type] || 'var(--text)';
    
    modalTitle.style.color = color;
    modalBody.style.color = color;
    loader.style.color = color;
    
    const dayConfig = GymStore.schedule[dayIndex];
    let titleText = '';
    let exercises = [];
    let vidKey = 'chest';
    
    if (dayConfig.type === 'custom') {
        titleText = groupNum === 1 ? dayConfig.m1 : dayConfig.m2;
        exercises = dayConfig.customExercises || [];
    } else {
        const data = PROTOCOL_DB[dayConfig.dbIndex];
        if (data) {
            titleText = groupNum === 1 ? data.t1 : data.t2;
            exercises = groupNum === 1 ? data.ex1 : data.ex2;
            vidKey = groupNum === 1 ? data.vid1 : data.vid2;
        }
    }
    
    modalTitle.innerHTML = `🧬 LOADING ${titleText}...`;

    setTimeout(() => {
        loader.style.display = 'none';
        modalTitle.innerHTML = `🧬 ${titleText}`;
        
        let htmlContent = `<div id="exerciseListContainer">`;
        
        if (exercises.length === 0) {
            htmlContent += `<div class="empty-state">No exercises configured for this group. Customize this day to add exercises!</div>`;
        } else {
            exercises.forEach((ex) => {
                const safeName = ex.name.replace(/'/g, "\\'");
                htmlContent += `
                    <div class="exercise-item" onclick="playVideo('${vidKey}', ${ex.start || 0}, '${safeName}', '${color}')">
                        <div class="ex-info">
                            <strong style="color: var(--text);">${ex.name}</strong>
                            <span>${ex.desc || ''}</span>
                        </div>
                        <div class="time-badge">
                            ▶ ${ex.time || '3:00'}
                        </div>
                    </div>
                `;
            });
        }
        
        htmlContent += `</div>
            <div class="video-wrapper" id="videoWrapper">
                <button class="back-btn" onclick="backToList()">← BACK TO EXERCISES</button>
                <div class="video-container" id="videoContainer"></div>
                <h3 id="currentVideoTitle" style="margin-top: 15px; font-family: 'Oswald', sans-serif; font-size: 1.2rem; color: var(--text); line-height: 1.4;"></h3>
            </div>
        `;
        
        modalBody.innerHTML = htmlContent;
    }, 250);
}

function playVideo(vidKey, startSeconds, exerciseName, accentColor) {
    const listContainer = document.getElementById('exerciseListContainer');
    if (listContainer) listContainer.style.display = 'none';
    const videoWrapper = document.getElementById('videoWrapper');
    const videoContainer = document.getElementById('videoContainer');
    
    if (videoWrapper) videoWrapper.style.display = 'flex';
    
    const vData = VIDEO_DB[vidKey] || { id: '', index: 1 };
    const videoId = vData.id;
    
    let iframeSrc = '';
    
    const mins = Math.floor(startSeconds / 60);
    const secs = (startSeconds % 60).toString().padStart(2, '0');
    const formattedTime = `${mins}:${secs}`;
    
    if (videoId && videoId.trim() !== '') {
        iframeSrc = `https://www.youtube.com/embed/${videoId}?start=${startSeconds}&rel=0`;
        
        document.getElementById('currentVideoTitle').innerHTML = `
            ${exerciseName}
            <div style="margin-top: 15px; text-align: center;">
                <a href="https://www.youtube.com/watch?v=${videoId}&t=${startSeconds}s" target="_blank" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; background: ${accentColor}; color: #fff; text-decoration: none; border-radius: 6px; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.9rem; text-transform: uppercase; transition: all 0.2s ease; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                    Open directly in YouTube (At ${formattedTime})
                </a>
            </div>
        `;
    } else {
        iframeSrc = `https://www.youtube.com/embed/videoseries?list=PLRS2DE4P39EdzTqPZTL_uYvMZi7tichL0&index=${vData.index}`;
        document.getElementById('currentVideoTitle').innerHTML = `<span style="color: var(--text);">${exerciseName}</span>`;
    }
    
    if (videoContainer) {
        videoContainer.innerHTML = `
            <iframe 
                src="${iframeSrc}" 
                title="YouTube video player" 
                frameborder="0" 
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
            </iframe>
        `;
    }
}

function backToList() {
    const wrapper = document.getElementById('videoWrapper');
    if (wrapper) wrapper.style.display = 'none';
    const container = document.getElementById('videoContainer');
    if (container) container.innerHTML = ''; 
    const list = document.getElementById('exerciseListContainer');
    if (list) list.style.display = 'block';
}

function openProtocolModal(indexOrType, type, titleText) {
    if (indexOrType === 'rest') {
        modal.classList.add('active');
        modalBody.innerHTML = '';
        loader.style.display = 'block';
        
        modalTitle.style.color = 'var(--text)';
        loader.style.color = 'var(--text)';
        
        modalTitle.innerHTML = `🧬 LOADING ${titleText}...`;
        
        setTimeout(() => {
            loader.style.display = 'none';
            modalTitle.innerHTML = `🧬 ${titleText} PROTOCOL`;
            modalBody.innerHTML = `
                <h3>ACTIVE RECOVERY</h3>
                <ul style="color: var(--text);">
                    <li><strong>10-Min Mobility Flow:</strong> Focus on hips, thoracic spine, and ankles to prime for the next dynamic cycle.</li>
                    <li><strong>Nervous System Recovery:</strong> 5 minutes of box breathing (4s inhale, 4s hold, 4s exhale, 4s hold) to downregulate the sympathetic drive.</li>
                    <li><strong>Anatomical Restoration:</strong> Active soft tissue myofascial compression foam rolling. Focus on paraspinal fibers.</li>
                </ul>
            `;
        }, 300);
    }
}

// --- EXPORT SYSTEMS & SHARING LINKS ---
function exportCalendarICS() {
    let icsContent = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Apex Physiology//Power Plan//EN\r\n";
    
    const today = new Date();
    
    GymStore.schedule.forEach((dayConfig, idx) => {
        if (dayConfig.rest) return;
        
        // Match dayOfWeek index (0=Sun, 1=Mon, ..., 6=Sat in JS)
        // Schedule is [Mon, Tue, Wed, Thu, Fri, Sat, Sun] -> map index+1
        const targetDayOfWeek = idx === 6 ? 0 : idx + 1;
        
        // Find next occurrence of this day of week
        const targetDate = new Date(today);
        const currentDay = today.getDay();
        const diff = (targetDayOfWeek + 7 - currentDay) % 7;
        targetDate.setDate(today.getDate() + diff);
        
        const dateStr = targetDate.toISOString().split('T')[0].replace(/-/g, '');
        const summary = `Workout: ${dayConfig.name || dayConfig.type.toUpperCase()}`;
        const description = `Muscle Target: ${dayConfig.m1} (${dayConfig.sub1})\\n${dayConfig.m2 ? dayConfig.m2 + ' (' + dayConfig.sub2 + ')' : ''}`;
        
        icsContent += "BEGIN:VEVENT\r\n";
        icsContent += `DTSTART;VALUE=DATE:${dateStr}\r\n`;
        icsContent += `RRULE:FREQ=WEEKLY;BYDAY=${["SU","MO","TU","WE","TH","FR","SA"][targetDayOfWeek]}\r\n`;
        icsContent += `SUMMARY:${summary}\r\n`;
        icsContent += `DESCRIPTION:${description}\r\n`;
        icsContent += "END:VEVENT\r\n";
    });
    
    icsContent += "END:VCALENDAR\r\n";
    
    // Download
    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = "apex_physiology_power_plan.ics";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    showToast("iCal schedule downloaded! Import it to Google/Apple Calendar.", "📅");
}

function shareAccountabilityLink() {
    // Compress plan schedule and encode to base64
    const compressed = btoa(JSON.stringify(GymStore.schedule));
    const shareUrl = `${window.location.origin}${window.location.pathname}?plan=${compressed}`;
    
    // Copy
    navigator.clipboard.writeText(shareUrl).then(() => {
        showToast("Shareable accountability link copied to clipboard!", "🔗");
    }).catch(() => {
        alert("Failed to copy link. Share this string:\n" + shareUrl);
    });
}

function checkSharedQuery() {
    const params = new URLSearchParams(window.location.search);
    const planB64 = params.get('plan');
    if (planB64) {
        try {
            const parsed = JSON.parse(atob(planB64));
            if (Array.isArray(parsed) && parsed.length === 7) {
                // Show shared preview banner
                window.sharedPreviewPlan = parsed;
                document.getElementById('sharedPreviewBanner').style.display = 'flex';
                
                // Temporarily inject to preview
                GymStore.schedule = parsed;
                renderGrid();
                renderPicker();
                showToast("Loading shared gym buddy training plan preview!", "🤝");
            }
        } catch(e) {
            console.error("Shared query error:", e);
        }
    }
}

function importSharedPlan() {
    if (window.sharedPreviewPlan) {
        GymStore.schedule = window.sharedPreviewPlan;
        GymStore.onboarded = true;
        saveStore();
        
        document.getElementById('sharedPreviewBanner').style.display = 'none';
        
        // Clean URL query
        window.history.replaceState({}, document.title, window.location.pathname);
        
        renderGrid();
        renderPicker();
        ConfettiEngine.burst(window.innerWidth/2, window.innerHeight/2, 100);
        showToast("Imported successfully! Welcome to your partner plan.", "🔥");
    }
}

function cancelPreviewPlan() {
    document.getElementById('sharedPreviewBanner').style.display = 'none';
    window.history.replaceState({}, document.title, window.location.pathname);
    
    // Reload local saved plan
    loadStore();
    renderGrid();
    renderPicker();
}

function exportSummaryPNG() {
    try {
        const canvas = document.createElement('canvas');
        canvas.width = 600;
        canvas.height = 400;
        const ctx = canvas.getContext('2d');
        
        // Drawing custom slate cards style onto a canvas
        ctx.fillStyle = '#0F1419'; // Deep charcoal background
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Accent bar
        ctx.fillStyle = '#00D9FF';
        ctx.fillRect(0, 0, canvas.width, 15);
        
        // Brand Title
        ctx.fillStyle = '#FFFFFF';
        ctx.font = 'bold 24px Oswald, sans-serif';
        ctx.fillText("APEX PHYSIOLOGY PROTOCOL", 30, 60);
        
        ctx.fillStyle = '#85929E';
        ctx.font = '14px Inter, sans-serif';
        ctx.fillText("TRAINING COMPANION ACHIEVEMENTS CARD", 30, 80);
        
        // Horizontal separator
        ctx.strokeStyle = '#24303F';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(30, 110);
        ctx.lineTo(570, 110);
        ctx.stroke();
        
        // Stats boxes
        ctx.fillStyle = '#151C24'; // Card bg
        ctx.fillRect(30, 140, 160, 180);
        ctx.fillRect(220, 140, 160, 180);
        ctx.fillRect(410, 140, 160, 180);
        
        // Card borders
        ctx.strokeStyle = '#24303F';
        ctx.strokeRect(30, 140, 160, 180);
        ctx.strokeRect(220, 140, 160, 180);
        ctx.strokeRect(410, 140, 160, 180);
        
        // Values text
        ctx.fillStyle = '#FFFFFF';
        ctx.textAlign = 'center';
        
        // Box 1: Streak
        ctx.font = 'bold 12px Inter, sans-serif';
        ctx.fillStyle = '#85929E';
        ctx.fillText("ACTIVE STREAK", 110, 180);
        ctx.font = 'bold 36px Oswald, sans-serif';
        ctx.fillStyle = '#FF6B5B'; // Orange-red
        ctx.fillText(`🔥 ${GymStore.streak}`, 110, 240);
        ctx.font = '11px Inter, sans-serif';
        ctx.fillStyle = '#85929E';
        ctx.fillText("consecutive days", 110, 270);
        
        // Box 2: Total Completed
        ctx.font = 'bold 12px Inter, sans-serif';
        ctx.fillStyle = '#85929E';
        ctx.fillText("SESSIONS LOGGED", 300, 180);
        ctx.font = 'bold 36px Oswald, sans-serif';
        ctx.fillStyle = '#39FF14'; // Lime Green
        ctx.fillText(`${GymStore.history.length}`, 300, 240);
        ctx.font = '11px Inter, sans-serif';
        ctx.fillStyle = '#85929E';
        ctx.fillText("total completed", 300, 270);
        
        // Box 3: Best Record
        ctx.font = 'bold 12px Inter, sans-serif';
        ctx.fillStyle = '#85929E';
        ctx.fillText("ALL-TIME LONGEST", 490, 180);
        ctx.font = 'bold 36px Oswald, sans-serif';
        ctx.fillStyle = '#00D9FF'; // Electric blue
        ctx.fillText(`${GymStore.longestStreak} DAYS`, 490, 240);
        ctx.font = '11px Inter, sans-serif';
        ctx.fillStyle = '#85929E';
        ctx.fillText("consecutive record", 490, 270);
        
        // Footer branding
        ctx.textAlign = 'left';
        ctx.fillStyle = '#85929E';
        ctx.font = '11px Inter, sans-serif';
        ctx.fillText("Join the cycle: and build your peak training timeline.", 30, 365);
        
        // Trigger download
        const image = canvas.toDataURL("image/png");
        const a = document.createElement('a');
        a.href = image;
        a.download = "apex_physiology_achievements_card.png";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        showToast("PNG Accomplishments Card downloaded!", "🖼️");
    } catch(e) {
        console.error("Canvas export failed:", e);
        alert("Canvas rendering is restricted by your current device configurations.");
    }
}

// --- GLOBAL KEYBOARD SHORTCUT LISTENERS ---
// Listen for keys: space, T, Q, Esc, numbers 1-4, and '?'
window.addEventListener('keydown', (e) => {
    // Ignore when focus is inside text fields or date picker
    if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA' || document.activeElement.tagName === 'SELECT') {
        return;
    }
    
    const key = e.key.toLowerCase();
    
    if (e.key === ' ') {
        e.preventDefault();
        // Toggle stopwatch / rest timer start/pause
        toggleRestTimerWidget();
        startTimer();
    } else if (key === 't') {
        // Cycle premium themes
        const themes = ['slate-light', 'dark-clinical', 'warm-minimal', 'neon-sports'];
        let currentIdx = themes.indexOf(GymStore.theme);
        let nextIdx = (currentIdx + 1) % themes.length;
        changeTheme(themes[nextIdx]);
        
        const sel = document.getElementById('themeSelector');
        if (sel) sel.value = themes[nextIdx];
        
        showToast(`Theme cycled to ${themes[nextIdx].toUpperCase()}!`, "🎨");
    } else if (key === 'q') {
        // Trigger onboarding quiz
        triggerQuizOnDemand();
    } else if (e.key === 'Escape') {
        // Close modal
        closeModal();
    } else if (key === '1') {
        switchTab('week');
    } else if (key === '2') {
        switchTab('calendar');
    } else if (key === '3') {
        switchTab('history');
    } else if (key === '4') {
        switchTab('analytics');
    } else if (e.key === '?') {
        openShortcutsModal();
    }
});

function openShortcutsModal() {
    modal.classList.add('active');
    modalBody.innerHTML = '';
    loader.style.display = 'block';
    
    modalTitle.innerHTML = `⌨️ Apex Dashboard Keyboard Shortcuts`;
    modalTitle.style.color = 'var(--text)';
    
    setTimeout(() => {
        loader.style.display = 'none';
        modalBody.innerHTML = `
            <div style="background:var(--bg); border:1px solid var(--border); border-radius:12px; padding:15px; margin-bottom:15px; font-size:0.9rem;">
                <h4 style="font-family:'Oswald',sans-serif; margin-bottom:10px; text-transform:uppercase;">Global Hotkeys:</h4>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid var(--border);">
                    <span><strong>[Spacebar]</strong></span>
                    <span>Toggle stopwatch timer / start countdown</span>
                </div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid var(--border);">
                    <span><strong>[T] Key</strong></span>
                    <span>Cycle between 4 premium color themes</span>
                </div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid var(--border);">
                    <span><strong>[Q] Key</strong></span>
                    <span>Open onboarding personalization quiz</span>
                </div>
                <div style="display:flex; justify-content:space-between; padding:5px 0; border-bottom:1px solid var(--border);">
                    <span><strong>[1], [2], [3], [4] Keys</strong></span>
                    <span>Switch Views (Week, Calendar, History, Analytics)</span>
                </div>
                <div style="display:flex; justify-content:space-between; padding:5px 0;">
                    <span><strong>[Escape] Key</strong></span>
                    <span>Close current open modal dialogue overlay</span>
                </div>
            </div>
            <div style="text-align:right;">
                <button class="rest-btn" onclick="closeModal()">Close</button>
            </div>
        `;
    }, 200);
}

// --- MOBILE TOUCH SWIPES GESTURES ---
// Detect swipes left/right on week view to swap tabs
let touchStartX = 0;
let touchStartY = 0;

document.getElementById('weekView').addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
}, false);

document.getElementById('weekView').addEventListener('touchend', (e) => {
    const endX = e.changedTouches[0].screenX;
    const endY = e.changedTouches[0].screenY;
    
    const diffX = endX - touchStartX;
    const diffY = endY - touchStartY;
    
    // Check if horizontal swipe and not vertical scroll
    if (Math.abs(diffX) > 100 && Math.abs(diffY) < 50) {
        if (diffX > 0) {
            // Swiped right -> go to analytics
            switchTab('analytics');
            showToast("Swipe navigation: Analytics", "📱");
            triggerVibrate(20);
        } else {
            // Swiped left -> go to calendar
            switchTab('calendar');
            showToast("Swipe navigation: Calendar", "📱");
            triggerVibrate(20);
        }
    }
}, false);

// === VOICE COUNTER SYSTEM ===
const VoiceCounter = {
    recognition: null,
    isListening: false,
    currentReps: 0,
    currentSet: 1,
    
    numberMap: {
        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4, 'five': 5,
        'six': 6, 'seven': 7, 'eight': 8, 'nine': 9, 'ten': 10,
        'eleven': 11, 'twelve': 12, 'thirteen': 13, 'fourteen': 14, 'fifteen': 15,
        'sixteen': 16, 'seventeen': 17, 'eighteen': 18, 'nineteen': 19, 'twenty': 20
    },
    
    init() {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) {
            document.getElementById('voiceTranscript').textContent = '❌ Speech recognition not supported in your browser';
            document.getElementById('micStatus').style.opacity = '0.5';
            document.getElementById('micStatus').style.cursor = 'not-allowed';
            return;
        }
        
        this.recognition = new SpeechRecognition();
        this.recognition.continuous = true;
        this.recognition.interimResults = true;
        this.recognition.lang = 'en-US';
        
        this.recognition.onstart = () => {
            this.isListening = true;
            this.updateMicStatus();
        };
        
        this.recognition.onresult = (event) => {
            let interimTranscript = '';
            let finalTranscript = '';
            
            for (let i = event.resultIndex; i < event.results.length; i++) {
                const transcript = event.results[i].transcript.toLowerCase().trim();
                
                if (event.results[i].isFinal) {
                    finalTranscript += transcript + ' ';
                } else {
                    interimTranscript += transcript;
                }
            }
            
            // Display live transcript
            const display = finalTranscript || interimTranscript;
            document.getElementById('voiceTranscript').textContent = display || 'Listening...';
            document.getElementById('voiceTranscript').classList.add('active');
            
            // Parse and update counter
            if (finalTranscript) {
                this.parseAndUpdate(finalTranscript);
            }
        };
        
        this.recognition.onerror = (event) => {
            document.getElementById('voiceTranscript').textContent = `🔴 Error: ${event.error}`;
        };
        
        this.recognition.onend = () => {
            this.isListening = false;
            this.updateMicStatus();
        };
        
        this.loadState();
    },
    
    parseAndUpdate(transcript) {
        const words = transcript.split(/\s+/);
        
        for (let word of words) {
            // Match number words
            if (this.numberMap.hasOwnProperty(word)) {
                const num = this.numberMap[word];
                this.currentReps = num;
                this.updateDisplay();
                this.animatePulse('repBoxDisplay');
                showToast(`Rep set to ${num}`, '💪');
                return;
            }
            
            // Match numeric strings
            const numMatch = word.match(/\d+/);
            if (numMatch) {
                const num = parseInt(numMatch[0]);
                if (num <= 100) {
                    this.currentReps = num;
                    this.updateDisplay();
                    this.animatePulse('repBoxDisplay');
                    showToast(`Rep set to ${num}`, '💪');
                    return;
                }
            }
        }
    },
    
    updateDisplay() {
        document.getElementById('repCount').textContent = this.currentReps;
        document.getElementById('setCount').textContent = this.currentSet;
    },
    
    updateMicStatus() {
        const status = document.getElementById('micStatus');
        const statusText = document.getElementById('micStatusText');
        
        if (this.isListening) {
            status.classList.add('listening');
            status.classList.remove('active');
            statusText.textContent = '🎤 LISTENING...';
        } else {
            status.classList.remove('listening');
            status.classList.add('active');
            statusText.textContent = '🎤 Ready to listen (click to start)';
        }
    },
    
    animatePulse(elementId) {
        const el = document.getElementById(elementId);
        el.classList.remove('pulse');
        void el.offsetWidth; // Trigger reflow
        el.classList.add('pulse');
        setTimeout(() => el.classList.remove('pulse'), 300);
    },
    
    toggle() {
        if (this.isListening) {
            this.recognition.stop();
        } else {
            document.getElementById('voiceTranscript').textContent = 'Listening...';
            this.recognition.start();
        }
    },
    
    nextSet() {
        this.currentSet++;
        this.currentReps = 0;
        this.updateDisplay();
        this.animatePulse('setBoxDisplay');
        showToast(`Set ${this.currentSet} started!`, '🔥');
    },
    
    reset() {
        this.currentReps = 0;
        this.currentSet = 1;
        this.updateDisplay();
        document.getElementById('voiceTranscript').textContent = 'Counter reset';
        showToast('Counter reset to Set 1, Rep 0', '↺');
        this.recognition.stop();
        this.isListening = false;
        this.updateMicStatus();
    },
    
    saveState() {
        localStorage.setItem('voiceCounterState', JSON.stringify({
            reps: this.currentReps,
            set: this.currentSet
        }));
    },
    
    loadState() {
        const saved = localStorage.getItem('voiceCounterState');
        if (saved) {
            const state = JSON.parse(saved);
            this.currentReps = state.reps || 0;
            this.currentSet = state.set || 1;
            this.updateDisplay();
        }
    }
};

function toggleVoiceCounter() {
    VoiceCounter.toggle();
}

function incrementRep() {
    VoiceCounter.currentReps++;
    VoiceCounter.updateDisplay();
    VoiceCounter.animatePulse('repBoxDisplay');
    VoiceCounter.saveState();
    showToast(`Rep: ${VoiceCounter.currentReps}`, '💪');
}

function decrementRep() {
    if (VoiceCounter.currentReps > 0) {
        VoiceCounter.currentReps--;
        VoiceCounter.updateDisplay();
        VoiceCounter.animatePulse('repBoxDisplay');
        VoiceCounter.saveState();
        showToast(`Rep: ${VoiceCounter.currentReps}`, '💪');
    }
}

function incrementSet() {
    VoiceCounter.currentSet++;
    VoiceCounter.updateDisplay();
    VoiceCounter.animatePulse('setBoxDisplay');
    VoiceCounter.saveState();
    showToast(`Set: ${VoiceCounter.currentSet}`, '🔥');
}

function decrementSet() {
    if (VoiceCounter.currentSet > 1) {
        VoiceCounter.currentSet--;
        VoiceCounter.updateDisplay();
        VoiceCounter.animatePulse('setBoxDisplay');
        VoiceCounter.saveState();
        showToast(`Set: ${VoiceCounter.currentSet}`, '🔥');
    }
}

function nextSet() {
    VoiceCounter.nextSet();
    VoiceCounter.saveState();
}

function resetCounter() {
    VoiceCounter.reset();
    VoiceCounter.saveState();
}

// Initialize voice counter on page load
document.addEventListener('DOMContentLoaded', () => {
    VoiceCounter.init();
    VoiceCounter.updateDisplay();
});

window.onload = init;
</script>
</body>
</html>
